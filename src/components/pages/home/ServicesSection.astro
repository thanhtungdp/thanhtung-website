---
import SectionHeading from './SectionHeading.astro';

interface Props {
	isVi: boolean;
	services: string[];
}

const { isVi, services } = Astro.props;
const serviceLabels = isVi
	? ['Vận hành', 'AI agents', 'Coaching', 'Triển khai']
	: ['Operating rhythm', 'AI agents', 'Coaching', 'Execution'];
---

<section class="relative grid grid-cols-1 items-start gap-8 py-8 md:py-12 lg:grid-cols-2 lg:gap-14 lg:py-14">
	<SectionHeading
		kicker={isVi ? 'Cách hợp tác' : 'How we can work together'}
		title={isVi ? 'Từ chiến lược đến AI agents chạy trong vận hành' : 'From strategy to AI agents inside real operations'}
		narrow
	/>
	<div class="grid gap-3">
		{
			services.map((item, index) => (
				<div class="flex flex-col items-start gap-2 rounded-2xl border border-neutral-200 bg-white/80 p-4 sm:flex-row sm:gap-4">
					<span class="inline-flex min-h-7 items-center rounded-full bg-orange-50 px-2.5 py-1 text-xs font-black leading-none text-orange-700">{serviceLabels[index]}</span>
					<p class="m-0 text-base font-bold leading-7 text-neutral-950 sm:text-lg">{item}</p>
				</div>
			))
		}
	</div>
</section>
