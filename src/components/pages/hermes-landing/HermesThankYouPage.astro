---
import BaseHead from '../../BaseHead.astro';
import { Image } from 'astro:assets';
import DavidTungLogo from '../../../assets/david-tung-logo-upload.png';
import HermesIcon from '../../../assets/hermes-landing/icon.png';
import ThankYouHeroBackground from './ThankYouHeroBackground.astro';
import CheckOutModal from '../../ui/CheckOutModal';
import { nav, hero, journey, upsell, whatNow, footer } from './hermesThankYouContent';
import { defaultLocale } from '../../../i18n';

const title = 'Cảm ơn — Hermes Agent';
const description =
	'Cảm ơn anh đã kích hoạt Hermes Agent. Đây là hành trình tiếp theo và 3 việc cần làm để bắt đầu ngay.';

// Shared container — single source of truth for width + vertical rhythm.
const page = 'mx-auto w-full max-w-[1080px] px-[18px] sm:px-8';
const wrap = 'py-12 sm:py-16';
---

<!doctype html>
<html lang={defaultLocale}>
	<head>
		<BaseHead title={title} description={description} locale={defaultLocale} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Space+Mono:wght@400;700&family=Newsreader:ital,opsz,wght@0,6..72,400..600;1,6..72,400..500&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body class="hermes-landing hermes-grid-bg">
		<!-- NAV -->
		<nav class="sticky top-0 z-50 border-b-2 border-hermes-ink bg-hermes-paper">
			<div class={`${page} flex h-[58px] items-center gap-3`}>
				<div
					class="flex h-full min-w-0 items-center gap-2 pr-3 font-hermes-mono text-[13px] font-bold uppercase tracking-[0.04em] sm:gap-2.5 sm:border-r-2 sm:border-hermes-ink sm:pr-5"
				>
					<Image src={DavidTungLogo} alt="David Tung" class="!h-5 w-auto !rounded-none sm:!h-6" />
					<span class="text-hermes-hair">|</span>
					<Image src={HermesIcon} alt="Hermes" class="!h-[18px] w-auto !rounded-none sm:!h-5" />
					<span class="hidden whitespace-nowrap min-[420px]:inline"
						>{nav.brandName} <b class="text-hermes-orange">{nav.brandAccent}</b></span
					>
				</div>
				<span class="ml-auto font-hermes-mono text-xs text-hermes-muted">{nav.orderLabel}</span>
			</div>
		</nav>

		<!-- CONFIRMATION HERO -->
		<header
			class="relative overflow-hidden border-2 border-t-0 border-hermes-ink text-white"
			style="background:radial-gradient(125% 110% at 72% -10%, #2a2418 0%, #16140f 46%, #090806 100%);"
		>
			<ThankYouHeroBackground />
			<div class={`${page} relative z-10 px-6 py-12 sm:px-14 sm:py-16`}>
				<div
					class="mb-7 grid !h-[60px] !w-[60px] shrink-0 place-items-center bg-hermes-orange text-3xl font-bold text-white shadow-[6px_6px_0_#000]"
				>
					✓
				</div>
				<span class="hermes-eyebrow">{hero.eyebrow}</span>
				<h1 class="my-5 max-w-[18ch] text-4xl !text-white sm:text-5xl lg:text-6xl">
					{hero.titleLead}{' '}
					<em class="font-hermes-serif font-medium italic text-hermes-orange">{hero.titleEm}</em>
				</h1>
				<p class="max-w-[54ch] text-[18px] leading-[1.6] text-[#d7cfc2]">{hero.lede}</p>
				<div class="mt-10 grid grid-cols-1 border-2 border-hermes-ink bg-white/[0.04] sm:grid-cols-3">
					{
						hero.receipt.map((item, i) => (
							<div
								class:list={[
									'px-6 py-5',
									i < hero.receipt.length - 1 && 'border-b-2 border-hermes-ink sm:border-b-0 sm:border-r-2',
								]}
							>
								<div class="mb-2 font-hermes-mono text-[11px] uppercase tracking-[0.1em] text-[#a89c8c]">
									{item.k}
								</div>
								<div class:list={['text-[18px] font-bold', item.ok ? 'text-hermes-orange' : 'text-white']}>
									{item.v}
								</div>
							</div>
						))
					}
				</div>
			</div>
		</header>

		<!-- JOURNEY -->
		<section>
			<div class={`${page} ${wrap}`}>
				<div class="mb-11">
					<span class="hermes-eyebrow">{journey.eyebrow}</span>
					<h2 class="mt-4 max-w-[20ch] text-3xl sm:text-4xl lg:text-5xl">{journey.title}</h2>
				</div>
				<div class="border-2 border-hermes-ink bg-hermes-card">
					{
						journey.steps.map((step, i) => (
							<div
								class:list={[
									'grid grid-cols-1 sm:grid-cols-[120px_1fr]',
									i < journey.steps.length - 1 && 'border-b-2 border-hermes-ink',
									step.state === 'now' && 'bg-[#fff7f2]',
								]}
							>
								<div class="flex items-center gap-3 border-b-2 border-hermes-hair px-6 py-5 sm:flex-col sm:items-center sm:justify-start sm:gap-1.5 sm:border-b-0 sm:border-r-2 sm:border-hermes-ink sm:py-8">
									<div
										class:list={[
											'grid h-[38px] w-[38px] place-items-center border-2 font-hermes-mono text-sm font-bold',
											step.state === 'now'
												? 'border-hermes-orange bg-hermes-orange text-white'
												: step.state === 'next'
													? 'border-hermes-ink bg-hermes-ink text-hermes-paper'
													: 'border-hermes-ink bg-hermes-paper',
										]}
									>
										{step.n}
									</div>
									<div class="font-hermes-mono text-[10px] tracking-[0.06em] text-hermes-muted sm:text-center">
										{step.when}
									</div>
								</div>
								<div class="px-6 py-7 sm:px-8">
									<span class="font-hermes-mono text-[11px] font-bold uppercase tracking-[0.1em] text-hermes-orange">
										{step.tag}
									</span>
									<h3 class="my-2 text-2xl">{step.title}</h3>
									<p class="max-w-[60ch] text-[15.5px] text-hermes-muted">{step.body}</p>
								</div>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<!-- UPSELL -->
		<section id="coach" class="bg-hermes-ink text-hermes-paper">
			<div class={`${page} ${wrap}`}>
				<div class="grid grid-cols-1 border-2 border-hermes-orange lg:grid-cols-[1.15fr_0.85fr]">
					<div class="border-b-2 border-hermes-orange px-7 py-10 sm:px-11 lg:border-b-0 lg:border-r-2">
						<span class="hermes-eyebrow">{upsell.eyebrow}</span>
						<h2 class="my-5 text-3xl !text-hermes-paper sm:text-4xl lg:text-5xl">
							{upsell.titleLead}{' '}
							<em class="font-hermes-serif font-medium italic text-hermes-orange">{upsell.titleEm}</em>{' '}
							{upsell.titleRest}
						</h2>
						<p class="max-w-[46ch] text-[16px] leading-[1.6] text-[#c9c0b3]">{upsell.body}</p>
						<ul class="mt-7 flex flex-col gap-3.5">
							{
								upsell.list.map((item) => (
									<li class="relative pl-7 text-[15.5px] leading-[1.45] before:absolute before:left-0 before:font-bold before:text-hermes-orange before:content-['✓']">
										{item}
									</li>
								))
							}
						</ul>
					</div>
					<div class="flex flex-col bg-[#1c1812] px-7 py-10 sm:px-10">
						<div class="mb-6 flex border-2 border-hermes-line-soft">
							{
								upsell.specs.map((spec, i) => (
									<div
										class:list={[
											'flex-1 px-4 py-4 text-center',
											i < upsell.specs.length - 1 && 'border-r-2 border-hermes-line-soft',
										]}
									>
										<div class="font-hermes-serif text-[26px] font-bold italic text-hermes-orange">
											{spec.n}
										</div>
										<div class="mt-1 font-hermes-mono text-[10px] uppercase tracking-[0.08em] text-[#a89c8c]">
											{spec.l}
										</div>
									</div>
								))
							}
						</div>
						<div class="font-hermes-mono text-[16px] text-[#a89c8c] line-through">{upsell.priceWas}</div>
						<div class="my-1 text-5xl font-bold leading-none tracking-[-0.03em] text-hermes-orange sm:text-6xl">
							{upsell.priceNow}<span class="font-hermes-mono text-lg text-[#a89c8c]">{upsell.priceUnit}</span>
						</div>
						<div class="mt-2.5 inline-block self-start bg-hermes-orange px-3 py-1.5 font-hermes-mono text-[11px] font-bold tracking-[0.06em] text-[#1a120c]">
							{upsell.save}
						</div>
						<button
							type="button"
							id="upsellCta"
							class="hermes-press mt-auto flex w-full items-center justify-center gap-2.5 border-2 border-hermes-orange bg-hermes-orange px-6 py-4 text-center text-[15px] font-bold !text-white"
						>
							{upsell.cta.label}
						</button>
						<button
							type="button"
							id="declineUpsell"
							class="mt-3.5 cursor-pointer text-center font-hermes-mono text-xs text-[#8a8073] underline"
						>
							{upsell.decline}
						</button>
						<div
							class="mt-[18px] flex items-center gap-2 font-hermes-mono text-[11px] tracking-[0.04em] text-[#8a8073] before:h-[7px] before:w-[7px] before:rounded-full before:bg-hermes-orange before:content-['']"
						>
							{upsell.note}
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- WHAT NOW -->
		<section id="what-now">
			<div class={`${page} ${wrap}`}>
				<div class="mb-11">
					<span class="hermes-eyebrow">{whatNow.eyebrow}</span>
					<h2 class="mt-4 text-3xl sm:text-4xl lg:text-5xl">{whatNow.title}</h2>
				</div>
				<div class="grid grid-cols-1 gap-0.5 border-2 border-hermes-ink bg-hermes-ink md:grid-cols-3">
					{
						whatNow.cards.map((card) => (
							<div class="bg-hermes-card px-7 py-8">
								<div class="font-hermes-mono text-xs font-bold text-hermes-orange">{card.n}</div>
								<h4 class="my-3.5 text-[19px]">{card.title}</h4>
								<p class="text-[14.5px] leading-[1.5] text-hermes-muted">{card.body}</p>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<!-- FOOTER -->
		<footer class="border-t-2 border-hermes-ink bg-hermes-ink text-hermes-paper">
			<div
				class={`${page} flex flex-wrap items-center justify-between gap-5 py-9 font-hermes-mono text-xs tracking-[0.04em]`}
			>
				<span>
					<span class="text-hermes-orange">{footer.left}</span>{footer.leftRest}
				</span>
				<span>{footer.right}</span>
			</div>
		</footer>

		<!-- CHECKOUT MODAL (for upsell) -->
		<CheckOutModal client:idle price={upsell.price} />

		<script>
			// "Decline" link scrolls down to the What-now section.
			document.getElementById('declineUpsell')?.addEventListener('click', () => {
				document.getElementById('what-now')?.scrollIntoView({ behavior: 'smooth' });
			});

			// Upsell CTA opens the checkout modal with coaching package details.
			document.getElementById('upsellCta')?.addEventListener('click', () => {
				// Retrieve user info from localStorage (saved on landing page)
				let fullname = '';
				let email = '';
				let phone = '';

				try {
					const saved = localStorage.getItem('hermes-user-info');
					if (saved) {
						const parsed = JSON.parse(saved);
						fullname = parsed.fullname || '';
						email = parsed.email || '';
						phone = parsed.phone || '';
					}
				} catch {
					// localStorage not available or corrupted - proceed with empty values
				}

				window.dispatchEvent(
					new CustomEvent('hermes:checkout', {
						detail: {
							fullname,
							email,
							phone,
							courseCode: 'HERMES-COACH-MINI4',
							price: '2.000.000₫',
						},
					}),
				);
			});
		</script>
	</body>
</html>

<style>
	.hermes-eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		font-family: var(--font-hermes-mono);
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--color-hermes-orange);
	}

	.hermes-eyebrow::before {
		content: '';
		width: 24px;
		height: 2px;
		background: var(--color-hermes-orange);
	}
</style>
