---
import Badge from '../../ui/Badge.astro';

interface Props {
	kicker: string;
	title: string;
	narrow?: boolean;
	titleClass?: string;
}

const { kicker, title, narrow = false, titleClass = '' } = Astro.props;
---

<div class:list={['mb-5', { 'max-w-3xl': narrow }]}>
	<Badge class="mb-4">{kicker}</Badge>
	<h2 class:list={['max-w-md text-3xl leading-tight tracking-tight sm:text-4xl lg:text-5xl', titleClass]}>
		{title}
	</h2>
</div>
