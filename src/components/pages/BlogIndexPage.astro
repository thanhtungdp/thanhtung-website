---
import { Image } from 'astro:assets';
import BaseHead from '../BaseHead.astro';
import Card from '../ui/Card.astro';
import Footer from '../Footer.astro';
import FormattedDate from '../FormattedDate.astro';
import ProjectAnimatedBackground from './project-detail/ProjectAnimatedBackground.astro';
import { SITE_TITLE } from '../../consts';
import { getTranslations, type Locale } from '../../i18n';
import { getBlogPath, getBlogPosts } from '../../lib/blog';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const posts = await getBlogPosts(locale);
---

<!doctype html>
<html lang={locale}>
	<head>
		<BaseHead title={`${t.blog.title} | ${SITE_TITLE}`} description={t.blog.description} locale={locale} />
	</head>
	<body>
		<ProjectAnimatedBackground>
		<main class="mx-auto max-w-6xl !px-4 !py-5 sm:!px-5 sm:!py-6 lg:!px-6 lg:!py-8">
			<section class="mb-5 max-w-3xl sm:mb-6">
				<p class="mb-4 inline-flex rounded-full border border-neutral-200 bg-white/75 px-3 py-1.5 text-sm font-extrabold text-orange-600 shadow-sm backdrop-blur">
					{posts.length} {locale === 'vi' ? 'bài viết' : 'articles'}
				</p>
				<h1 class="mb-4 text-5xl leading-none text-neutral-950 sm:text-6xl lg:text-7xl">{t.blog.title}</h1>
				<p class="max-w-2xl text-lg leading-8 text-neutral-600 sm:text-xl">{t.blog.description}</p>
			</section>

			<section class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3" aria-label={t.blog.title}>
				{
					posts.map((post, index) => (
						<Card class="group h-full overflow-hidden bg-white/85 transition hover:-translate-y-1 hover:border-orange-200 hover:shadow-xl">
							<article class="h-full">
								<a class="flex h-full flex-col text-inherit no-underline" href={getBlogPath(post, locale)}>
									{post.data.heroImage && (
										<div class="aspect-video overflow-hidden bg-orange-50">
											<Image
												class="block h-full w-full rounded-none object-cover transition duration-300 group-hover:scale-105"
												width={640}
												height={360}
												src={post.data.heroImage}
												alt=""
												loading={index === 0 ? 'eager' : 'lazy'}
											/>
										</div>
									)}
									<div class="flex flex-1 flex-col p-4 sm:p-5">
										<p class="mb-3 text-sm font-extrabold text-orange-600">
											<FormattedDate date={post.data.pubDate} locale={locale} />
										</p>
										<h2 class="mb-3 line-clamp-2 !text-2xl font-bold !leading-tight text-neutral-950 transition group-hover:text-orange-600">
											{post.data.title}
										</h2>
										<p class="mb-4 line-clamp-3 text-base leading-7 text-neutral-600">
											{post.data.description}
										</p>
										<span class="mt-auto text-sm font-extrabold text-orange-600">{t.blog.readMore}</span>
									</div>
								</a>
							</article>
						</Card>
					))
				}
			</section>
		</main>
		</ProjectAnimatedBackground>
		<Footer />
	</body>
</html>
