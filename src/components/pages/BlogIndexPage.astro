---
import BlogPostCard from '../blog/BlogPostCard.astro';
import BaseHead from '../BaseHead.astro';
import Footer from '../Footer.astro';
import AnnouncementBanner from '../AnnouncementBanner.astro';
import ProjectAnimatedBackground from './project-detail/ProjectAnimatedBackground.astro';
import { SITE_TITLE } from '../../consts';
import { getTranslations, type Locale } from '../../i18n';
import { getBlogPosts } from '../../lib/blog';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const posts = await getBlogPosts(locale);
---

<!doctype html>
<html lang={locale}>
	<head>
		<BaseHead title={`${t.blog.title} | ${SITE_TITLE}`} description={t.blog.description} locale={locale} />
	</head>
	<body>
		<AnnouncementBanner />
		<ProjectAnimatedBackground>
		<main class="mx-auto site-container !py-8">
			<section class="py-2">
				<div class="flex align-center justify-between">
					<h1 class="mb-4 text-5xl leading-none text-neutral-950 sm:text-6xl lg:text-7xl">{t.blog.title}</h1>
					<p class="mb-4 inline-flex rounded-full border border-neutral-200 bg-white/75 px-3 py-1.5 text-sm font-extrabold text-orange-600 shadow-sm backdrop-blur">
						{posts.length} {locale === 'vi' ? 'bài viết' : 'articles'}
					</p>
				</div>
			
				<p class="max-w-2xl text-lg leading-8 text-neutral-600 sm:text-xl">{t.blog.description}</p>
			</section>

			<section class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3" aria-label={t.blog.title}>
				{
					posts.map((post, index) => (
						<BlogPostCard post={post} locale={locale} readMoreLabel={t.blog.readMore} loading={index === 0 ? 'eager' : 'lazy'} />
					))
				}
			</section>
		</main>
		</ProjectAnimatedBackground>
		<Footer />
	</body>
</html>
