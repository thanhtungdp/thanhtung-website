---
type ProofStat = {
	value: string;
	label: string;
};

interface Props {
	stats: ProofStat[];
	label: string;
	class?: string;
}

const { stats, label, class: className = '' } = Astro.props;
---

<div
	class:list={[
		'surface-card grid grid-cols-2 gap-2 overflow-hidden bg-white/90 p-2 sm:grid-cols-4',
		className,
	]}
	aria-label={label}
>
	{
		stats.map((item) => (
			<div class="flex min-w-0 flex-col gap-2 rounded-2xl bg-orange-50 p-3">
				<strong class="block text-xl leading-none tracking-tight text-neutral-950">{item.value}</strong>
				<span class="block text-xs font-extrabold leading-tight text-neutral-500">{item.label}</span>
			</div>
		))
	}
</div>
