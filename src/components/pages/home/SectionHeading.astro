---
interface Props {
	kicker: string;
	title: string;
	narrow?: boolean;
	titleClass?: string;
}

const { kicker, title, narrow = false, titleClass = '' } = Astro.props;
---

<div class:list={['mb-5', { 'max-w-3xl': narrow }]}>
	{kicker && <span class="mb-4 inline-flex items-center gap-2 text-sm font-extrabold text-orange-700">
		<span class="h-1.5 w-1.5 rounded-full bg-orange-600" aria-hidden="true"></span>
		{kicker}
	</span>}
	<h2 class:list={['text-3xl leading-tight tracking-tight sm:text-4xl lg:text-5xl', titleClass]}>
		{title}
	</h2>
</div>
