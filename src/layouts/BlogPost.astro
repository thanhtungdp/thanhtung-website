---
import { Image } from 'astro:assets';
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import TableOfContents from '../components/blog/TableOfContents.astro';
import Badge from '../components/ui/Badge.astro';
import Card from '../components/ui/Card.astro';
import Footer from '../components/Footer.astro';
import AnnouncementBanner from '../components/AnnouncementBanner.astro';
import FormattedDate from '../components/FormattedDate.astro';
import ProjectAnimatedBackground from '../components/pages/project-detail/ProjectAnimatedBackground.astro';
import { defaultLocale, getTranslations, type Locale } from '../i18n';

type Props = CollectionEntry<'blog'>['data'] & {
	headings?: MarkdownHeading[];
	locale?: Locale;
};

const { title, description, pubDate, updatedDate, heroImage, headings = [], locale = defaultLocale } = Astro.props as Props;
const t = getTranslations(locale);
---

<html lang={locale}>
	<head>
		<BaseHead title={title} description={description} image={heroImage} locale={locale} />
	</head>

	<body>
		<AnnouncementBanner />
		<ProjectAnimatedBackground>
		<main class="mx-auto max-w-6xl !px-4 !py-5 sm:!px-5 sm:!py-6 lg:!px-6 lg:!py-8">
			<article>
				<header class="mx-auto mb-6 max-w-4xl text-left sm:mb-8 sm:text-center">
					<div class="mb-4 inline-flex flex-wrap items-center gap-2 sm:justify-center">
						<Badge><FormattedDate date={pubDate} locale={locale} /></Badge>
						{
							updatedDate && (
								<Badge>
									{t.blog.updatedPrefix}&nbsp;<FormattedDate date={updatedDate} locale={locale} />
								</Badge>
							)
						}
					</div>
					<h1 class="text-balance text-4xl font-bold leading-tight text-neutral-950 sm:text-5xl sm:leading-tight lg:text-6xl">
						{title}
					</h1>
					<p class="mt-3 max-w-3xl text-lg leading-8 text-neutral-600 sm:mx-auto sm:text-xl">
						{description}
					</p>
				</header>

				{heroImage && (
					<Card class="mx-auto mb-6 overflow-hidden p-1 sm:mb-8">
						<Image
							class="block aspect-video w-full rounded-xl object-cover"
							width={1280}
							height={720}
							src={heroImage}
							alt=""
							loading="eager"
						/>
					</Card>
				)}

				<div class="mx-auto grid w-full min-w-0 max-w-6xl gap-5 xl:grid-cols-[minmax(0,1fr)_16rem] xl:items-start">
					<div class="mx-auto w-full min-w-0 max-w-3xl">
						<TableOfContents headings={headings} locale={locale} variant="mobile" />
						<Card class="w-full min-w-0 p-4 sm:p-5 lg:p-6">
							<div
								class="min-w-0 break-words text-lg leading-8 text-neutral-700 sm:text-xl sm:leading-9 [&>*+*]:mt-5 [&_a]:font-semibold [&_a]:text-orange-600 [&_a:hover]:text-cyan-950 [&_h2]:mb-4 [&_h2]:mt-12 [&_h2]:scroll-mt-24 [&_h2]:text-3xl [&_h2]:font-bold [&_h2]:leading-tight [&_h2]:text-neutral-950 sm:[&_h2]:text-4xl [&_h3]:mb-4 [&_h3]:mt-10 [&_h3]:scroll-mt-24 [&_h3]:text-2xl [&_h3]:font-bold [&_h3]:leading-tight [&_h3]:text-neutral-950 [&_img]:mx-auto [&_img]:my-8 [&_img]:block [&_img]:w-full [&_img]:rounded-xl [&_img]:shadow-xl [&_li]:my-2 [&_li]:pl-1 [&_li::marker]:text-orange-600 [&_ol]:my-5 [&_ol]:list-decimal [&_ol]:pl-6 [&_p]:mb-5 [&_table]:my-8 [&_table]:block [&_table]:w-full [&_table]:overflow-x-auto [&_table]:rounded-xl [&_table]:border [&_table]:border-neutral-200 [&_table]:text-left [&_table]:text-base [&_tbody_tr:nth-child(even)]:bg-neutral-50/70 [&_td]:min-w-36 [&_td]:border-t [&_td]:border-neutral-200 [&_td]:px-4 [&_td]:py-3 [&_th]:min-w-36 [&_th]:bg-neutral-950 [&_th]:px-4 [&_th]:py-3 [&_th]:font-bold [&_th]:text-white [&_ul]:my-5 [&_ul]:list-disc [&_ul]:pl-6"
							>
								<slot />
							</div>
						</Card>
					</div>
					<TableOfContents headings={headings} locale={locale} variant="desktop" />
				</div>
			</article>
		</main>
		</ProjectAnimatedBackground>
		<Footer />
	</body>
</html>
