		<CheckOutModal client:idle price={cta.price} />

		<script>
			// Scene reveal for mockups: scroll into view triggers sequential reveal + active box shadow
			const mocks = document.getElementById('mocks');
			const badge = document.getElementById('sceneBadge');
			const badgeText = badge?.querySelector('[data-scene-text]');
			if (mocks && badge) {
				const cards = Array.from(mocks.querySelectorAll('.hermes-mock'));
				let played = false;
				function play() {
					if (played) return;
					played = true;
					badge.classList.add('opacity-100');
					cards.forEach((c, i) => {
						setTimeout(() => {
							c.classList.add('opacity-100', 'translate-y-0');
							c.classList.add('shadow-[0_0_0_2px_#f26c2c,_6px_6px_0_#f26c2c]');
							setTimeout(() => c.classList.remove('shadow-[0_0_0_2px_#f26c2c,_6px_6px_0_#f26c2c]'), 900);
							if (i === cards.length - 1 && badgeText) {
								setTimeout(() => {
									badge.classList.remove('opacity-100');
									setTimeout(() => {
										if (badgeText) badgeText.textContent = '✓ HERMES ĐÃ LÀM XONG';
										badge.classList.add('opacity-100');
									}, 300);
								}, 1000);
							}
						}, 500 + i * 750);
					});
				}
				cards.forEach((c) => {
					c.classList.add('opacity-30', 'translate-y-2.5', 'transition-all', 'duration-500');
				});
				const io = new IntersectionObserver(
					(entries) => entries.forEach((e) => e.isIntersecting && play()),
					{ threshold: 0.3 },
				);
				io.observe(mocks);
			}

			// FAQ accordion
			document.querySelectorAll('.hermes-faq-q').forEach((q) => {
				q.addEventListener('click', () => {
					const item = q.closest('.hermes-faq-item');
					const a = item?.querySelector('.hermes-faq-a') as HTMLElement;
					const icon = q.querySelector('.hermes-faq-icon') as HTMLElement;
					if (!item || !a || !icon) return;
					const isOpen = item.classList.contains('open');
					document.querySelectorAll('.hermes-faq-item').forEach((x) => {
						x.classList.remove('open');
						const xa = x.querySelector('.hermes-faq-a') as HTMLElement;
						const xi = x.querySelector('.hermes-faq-icon') as HTMLElement;
						if (xa) xa.style.maxHeight = '0';
						if (xi) xi.style.transform = 'rotate(0deg)';
					});
					if (!isOpen) {
						item.classList.add('open');
						a.style.maxHeight = a.scrollHeight + 'px';
						icon.style.transform = 'rotate(45deg)';
					}
				});
			});

			// Form submit → open the QR checkout modal with the buyer's details.
			const form = document.getElementById('signup') as HTMLFormElement | null;
			if (form) {
				const courseCode = form.dataset.courseCode || 'HERMES-999';

				// Quantity controls
				const qtyInput = document.getElementById('signup-qty') as HTMLInputElement | null;
				const qtyDecrease = document.getElementById('qty-decrease');
				const qtyIncrease = document.getElementById('qty-increase');

				if (qtyInput && qtyDecrease && qtyIncrease) {
					qtyDecrease.addEventListener('click', () => {
						const current = parseInt(qtyInput.value) || 1;
						if (current > 1) {
							qtyInput.value = String(current - 1);
						}
					});

					qtyIncrease.addEventListener('click', () => {
						const current = parseInt(qtyInput.value) || 1;
						qtyInput.value = String(current + 1);
					});

					// Ensure minimum value of 1
					qtyInput.addEventListener('change', () => {
						const current = parseInt(qtyInput.value) || 1;
						if (current < 1) {
							qtyInput.value = '1';
						}
					});
				}

				form.addEventListener('submit', (e) => {
					e.preventDefault();
					const get = (id: string) =>
						(document.getElementById(id) as HTMLInputElement | null)?.value.trim() ?? '';

					const userInfo = {
						fullname: get('signup-name'),
						email: get('signup-email'),
						phone: get('signup-phone'),
					};

					// Save user info to localStorage for thank-you page upsell
					try {
						localStorage.setItem('hermes-user-info', JSON.stringify(userInfo));
					} catch {
						// localStorage not available - non-fatal
					}

					const qty = parseInt(get('signup-qty')) || 1;

					window.dispatchEvent(
						new CustomEvent('hermes:checkout', {
							detail: {
								...userInfo,
								courseCode,
								qty,
							},
						}),
					);
				});
			}
		</script>
