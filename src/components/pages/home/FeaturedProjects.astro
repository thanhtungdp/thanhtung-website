---
import SectionHeading from './SectionHeading.astro';
import { MotionProjectGrid } from '../../motion/HomeMotion';

interface Props {
	isVi: boolean;
	projects: {
		title: string;
		desc: string;
		imageSrc: string;
		meta: string;
		role: string;
		impact: string;
		domain: string;
		cta: string;
		href?: string;
	}[];
}

const { isVi, projects } = Astro.props;
---

<section class="relative">
	<SectionHeading
		kicker={isVi ? 'Bằng chứng triển khai' : 'Proof in production'}
		title={isVi ? 'Hệ thống đã chạy ở quy mô thật' : 'Systems already running at scale'}
		titleClass="max-w-none whitespace-nowrap text-3xl sm:text-4xl lg:text-5xl"
	/>
	<MotionProjectGrid projects={projects} client:visible />
</section>
