---
import HomeOgImage from '../../assets/david-tung-og-x10.png';
import BaseHead from '../BaseHead.astro';
import Footer from '../Footer.astro';
import FeaturedProjects from './home/FeaturedProjects.astro';
import HomeAnimatedBackground from './home/HomeAnimatedBackground.astro';
import LatestWritingSection from './home/LatestWritingSection.astro';
import ServicesSection from './home/ServicesSection.astro';
import StatsSection from './home/StatsSection.astro';
import { getHomeContent } from './home/homeContent';
import { SITE_TITLE } from '../../consts';
import { getTranslations, type Locale } from '../../i18n';
import { getBlogPosts } from '../../lib/blog';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const latestPosts = (await getBlogPosts(locale)).slice(0, 3);
const { isVi, focusSignals, profileCard, proofStats, projectCards, services, stats } = getHomeContent(locale);
---

<!doctype html>
<html lang={locale}>
	<head>
		<BaseHead title={SITE_TITLE} description={t.siteDescription} image={HomeOgImage} locale={locale} />
	</head>
	<body>
		<HomeAnimatedBackground
			locale={locale}
			isVi={isVi}
			focusSignals={focusSignals}
			profileCard={profileCard}
			proofStats={proofStats}
		/>
		<main class="container mx-auto">
			<FeaturedProjects isVi={isVi} projects={projectCards} />
			<ServicesSection isVi={isVi} services={services} />
			<LatestWritingSection locale={locale} isVi={isVi} posts={latestPosts} />
			<StatsSection isVi={isVi} stats={stats} />
		</main>
		<Footer />
	</body>
</html>

<style is:global>
	@keyframes magic-grid-drift {
		from {
			background-position: 0 0;
		}
		to {
			background-position: 68px 68px;
		}
	}

	@keyframes hero-rise {
		from {
			opacity: 0;
			transform: translateY(24px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes magic-gradient {
		0%,
		100% {
			background-position: 0% 50%;
		}
		50% {
			background-position: 100% 50%;
		}
	}

	@keyframes x10-sweep {
		from {
			transform: scaleX(0);
		}
		to {
			transform: scaleX(1);
		}
	}
</style>
