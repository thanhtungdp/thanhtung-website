<!-- JS -->
<script>
// Hero simulator
(function() {
  const canvas = document.getElementById('sim-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const sim = document.getElementById('hero-sim');
  let W, H, particles = [];
  const PCOUNT = 35;

  function resize() {
    const r = sim.getBoundingClientRect();
    W = r.width; H = r.height;
    const dpr = window.devicePixelRatio || 1;
    canvas.width = W * dpr; canvas.height = H * dpr;
    canvas.style.width = W+'px'; canvas.style.height = H+'px';
    ctx.scale(dpr, dpr);
  }

  class P {
    constructor() {
      this.x = Math.random()*W; this.y = Math.random()*H;
      this.vx = (Math.random()-0.5)*0.3; this.vy = (Math.random()-0.5)*0.3;
      this.r = Math.random()*1.2+0.5; this.ph = Math.random()*Math.PI*2;
    }
    update() { this.x+=this.vx; this.y+=this.vy; this.ph+=0.015; if(this.x<-10||this.x>W+10||this.y<-10||this.y>H+10){this.x=Math.random()*W;this.y=Math.random()*H} }
    draw() { const a=Math.sin(this.ph)*0.2+0.25; ctx.fillStyle=`rgba(255,255,255,${a})`; ctx.beginPath(); ctx.arc(this.x,this.y,this.r,0,Math.PI*2); ctx.fill(); }
  }

  // Hero typewriter - faster: 25ms/char
  const termBody = document.getElementById('term-body');
  const tools = document.getElementById('sim-tools');
  const heroLines = [
    { p:'$', t:'Tạo báo giá cho Cty Thép Bình Minh - 100 cây 50x50', c:'', pc:'sim-prompt' },
    { p:'▶', t:'Tra cứu KH-042 + bảng giá hôm nay...', c:'gray', ind:true },
    { p:'▶', t:'Tính: 100×1.865.000 = 186.500.000₫, CK 3%', c:'gray', ind:true },
    { p:'▶', t:'Tạo file BG-20260624.docx từ template', c:'blue', ind:true },
    { p:'✓', t:'DOCX + PDF sẵn sàng', c:'green', ind:true },
    { p:'▶', t:'Gửi email đến khient@binhminhsteel.vn', c:'blue', ind:true },
    { p:'✓', t:'Đã gửi + lịch nhắc ngày 30/06', c:'green', ind:true },
    { p:'📦', t:'Skill "báo giá" đã cập nhật!', c:'green', ind:true },
  ];

  function heroType() {
    if(!termBody) return;
    termBody.innerHTML='';
    let li=0;
    function nx() {
      if(li>=heroLines.length){setTimeout(heroType,5000);return}
      const l=heroLines[li];
      const d=document.createElement('div');
      d.style.cssText='margin-bottom:3px;display:flex;gap:6px;font-size:0.65rem';
      if(l.ind) d.style.paddingLeft='14px';
      d.innerHTML=`<span style="color:${l.pc||'#D4D4D4'};flex-shrink:0">${l.p}</span> <span style="color:${l.c==='green'?'#27C93F':l.c==='blue'?'#6CB6FF':l.c==='gray'?'#858585':'#D4D4D4'}"></span><span class="cursor" style="animation:blink .8s step-end infinite">▊</span>`;
      termBody.appendChild(d);
      const ts=d.querySelector('span:nth-child(2)');
      let ci=0;
      function tc(){if(ci<l.t.length){ts.textContent+=l.t[ci];ci++;setTimeout(tc,25)}else{const cu=d.querySelector('.cursor');if(cu)cu.remove();li++;setTimeout(nx,900)}}
      setTimeout(tc,400);
    }
    setTimeout(nx,500);
  }

  setTimeout(()=>{resize();for(let i=0;i<PCOUNT;i++)particles.push(new P());document.getElementById('term-main').classList.add('shown');setTimeout(()=>tools.classList.add('shown'),1500);setTimeout(heroType,2000)},300);

  function anim(){ctx.clearRect(0,0,W,H);particles.forEach(p=>{p.update();p.draw()});requestAnimationFrame(anim)}
  window.addEventListener('resize',resize);
  requestAnimationFrame(anim);
})();

// Live demo typewriter - 25ms/char, scroll-triggered
(function() {
  const card=document.getElementById('terminal-demo'),body=document.getElementById('demo-body');
  if(!card||!body)return;
  const lines=[
    {p:'$',t:'Hermes, tạo báo giá cho Cty Thép Bình Minh - thép hộp 50x50, 100 cây',pc:'orange'},
    {p:'▶',t:'Đang tra cứu KH-042...',c:'gray'},
    {p:'▶',t:'Truy xuất bảng giá thép hộp hôm nay...',c:'gray'},
    {p:'▶',t:'Tính: 100×1.865.000=186.500.000₫, CK 3%→180.905.000₫',c:'gray'},
    {p:'▶',t:'Tạo file DOCX từ template → BG-20260624.docx',c:'blue'},
    {p:'✓',t:'Đã lưu báo giá tại /quotes/BG-20260624.docx',c:'green'},
    {p:'▶',t:'Gửi email đến khient@binhminhsteel.vn...',c:'blue'},
    {p:'✓',t:'Email đã gửi. Đã tạo lịch nhắc: gọi lại ngày 30/06.',c:'green'},
  ];
  let started=false;
  function start(){if(started)return;started=true;body.innerHTML='';let li=0;
    function nx(){
      if(li>=lines.length){const cd=document.createElement('div');cd.style.cssText='display:flex;gap:10px;margin-top:4px';cd.innerHTML='<span class="prompt green">⬡</span> <span class="text gray">Đang chờ lệnh...</span><span class="typing-cursor">▊</span>';body.appendChild(cd);return}
      const l=lines[li],d=document.createElement('div');d.className='term-line';
      d.innerHTML=`<span class="prompt ${l.pc||''}" style="color:${l.pc==='orange'?'#F86000':l.pc==='green'?'#27C93F':l.pc==='blue'?'#6CB6FF':'#858585'}">${l.p}</span> <span class="text ${l.c||''}"></span><span class="typing-cursor">▊</span>`;
      body.appendChild(d);const ts=d.querySelector('.text');let ci=0;
      function tc(){if(ci<l.t.length){ts.textContent+=l.t[ci];ci++;setTimeout(tc,25)}else{const cu=d.querySelector('.typing-cursor');if(cu)cu.remove();li++;setTimeout(nx,1200)}}
      setTimeout(tc,400);
    }
    setTimeout(nx,600);
  }
  new IntersectionObserver((e)=>{e.forEach(en=>{if(en.isIntersecting){card.classList.add('visible');start();this.disconnect()}})},{threshold:0.3}).observe(card);
})();
</script>
</body>
