---
import { SITE_TITLE } from '../../consts';
import { localizePath, type Locale } from '../../i18n';
import { getBlogPath, getBlogPosts } from '../../lib/blog';
import DashboardFeature from '../../assets/projects/simplamo/featured.png';
import AiFeature from '../../assets/projects/simplamo/ai-feature.webp';
import ScaleSlide from '../../assets/projects/simplamo/slide-03.webp';
import OperatingModelSlide from '../../assets/projects/simplamo/slide-06.webp';
import IntegrationSlide from '../../assets/projects/simplamo/slide-04.webp';
import DashboardSlide from '../../assets/projects/simplamo/slide-07.webp';
import AiSlide from '../../assets/projects/simplamo/slide-11.webp';
import ImplementationSlide from '../../assets/projects/simplamo/slide-14.webp';
import CaseSlide from '../../assets/projects/simplamo/slide-22.webp';
import ProjectDetailTemplate from './project-detail/ProjectDetailTemplate.astro';
import type { AchievementFirstProject } from './project-detail/types';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const isVi = locale === 'vi';

const relatedSlugs = [
	'tap-doan-austdoor-trien-khai-bsc-kpi-tren-simplamo',
	'bni-vietnam-ap-dung-4-nguyen-tac-thuc-thi-nang-cap-he-thong-quan-tri-tren-simplamo',
	'solarbk-trien-khai-simplamo-hoan-thien-he-thong-kpi-okrs',
	'cac-cap-do-ai-agent-trong-doanh-nghiep',
];

const posts = await getBlogPosts(locale);
const relatedPosts = relatedSlugs
	.map((slug) => {
		const post = posts.find((item) => [slug, `${slug}.md`, `${slug}.mdx`].includes(item.id.replace(`${locale}/`, '')));
		return post ? { post, path: getBlogPath(post, locale) } : null;
	})
	.filter((item): item is NonNullable<typeof item> => Boolean(item));

