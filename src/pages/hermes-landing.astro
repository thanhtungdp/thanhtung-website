---
// Hermes Agent Landing — v6: Split hero + reorder
const heroImg = '/hermes-landing/hero.webp';
const trap10xImg = '/hermes-landing/trap-10x.webp';
const trapAiImg = '/hermes-landing/trap-ai.webp';
const realizationImg = '/hermes-landing/realization.webp';
const learnImg = '/hermes-landing/what-you-learn.webp';
const logoImg = '/david-tung-logo.png';
const hermesLogo = '/hermes-logo.png';
---

<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Hermes Agent — Trợ lý thực thi tự tiến hóa | David Tùng</title>
  <meta name="description" content="Hermes không phải chatbot. Nó là trợ lý thực thi — biết làm việc, đóng gói skill, tự tiến hóa." />
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body { font-family: 'Inter', system-ui, sans-serif; background: #FAFAFA; color: #0A0A0A; line-height: 1.6; -webkit-font-smoothing: antialiased; }
    .dotted-bg { background-image: radial-gradient(circle, #D4D4D4 1px, transparent 1px); background-size: 24px 24px; }
    .container { max-width: 1100px; margin: 0 auto; padding: 0 24px; }
    img { max-width: 100%; height: auto; border-radius: 16px; }
    h1 { font-size: clamp(2rem, 5vw, 3.4rem); font-weight: 700; line-height: 1.15; letter-spacing: -0.03em; }
    h2 { font-size: clamp(1.5rem, 3.5vw, 2.2rem); font-weight: 700; line-height: 1.2; letter-spacing: -0.02em; }
    h3 { font-size: clamp(1rem, 2vw, 1.3rem); font-weight: 600; }
    p, li { font-size: 1rem; color: #525252; line-height: 1.7; }
    .text-orange { color: #F86000; } .text-muted { color: #A3A3A3; }
    .btn-primary { display: inline-flex; align-items: center; gap: 8px; background: #F86000; color: #fff; padding: 14px 32px; border-radius: 12px; font-weight: 600; font-size: 1.05rem; text-decoration: none; transition: all 0.2s; border: none; cursor: pointer; }
    .btn-primary:hover { background: #E05500; transform: translateY(-2px); box-shadow: 0 8px 24px rgba(248,96,0,0.25); }
    .btn-secondary { display: inline-flex; align-items: center; gap: 8px; background: transparent; color: #0A0A0A; padding: 14px 32px; border-radius: 12px; font-weight: 600; font-size: 1.05rem; text-decoration: none; border: 2px solid #0A0A0A; transition: all 0.2s; }
    .btn-secondary:hover { background: #0A0A0A; color: #fff; }
    header { position: sticky; top: 0; z-index: 100; background: rgba(250,250,250,0.85); backdrop-filter: blur(12px); border-bottom: 1px solid #E5E5E5; padding: 12px 0; }
    header .container { display: flex; align-items: center; justify-content: space-between; }
    .logo { display: flex; align-items: center; gap: 10px; text-decoration: none; color: #0A0A0A; font-weight: 700; font-size: 1.1rem; }
    .logo img { height: 28px; width: auto; border-radius: 0; }
    section { padding: 80px 0; } section.alt { background: #F2F2F2; }
    .section-label { display: inline-block; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.12em; color: #A3A3A3; margin-bottom: 8px; }
    .section-header { max-width: 640px; margin-bottom: 48px; }
    .section-header h2 { margin-bottom: 12px; }
    .mb-40 { margin-bottom: 40px; }

    /* ===== HERO SPLIT ===== */
    .hero { padding: 60px 0 80px; }
    .hero-split {
      display: grid; grid-template-columns: 1fr 1fr; gap: 48px;
      align-items: center;
    }
    .hero-left { text-align: left; }
    .hero-left .hero-badge {
      display: inline-flex; align-items: center; gap: 8px;
      background: #F5F5F5; padding: 8px 20px;
      border-radius: 100px; font-size: 0.85rem; font-weight: 600;
      color: #525252; margin-bottom: 20px; border: 1px solid #E5E5E5;
    }
    .hero-left .hero-badge img { height: 20px; width: auto; border-radius: 0; }
    .hero-left h1 { margin-bottom: 16px; }
    .hero-left .sub { font-size: 1.05rem; color: #737373; margin-bottom: 24px; }
    .hero-left .cta-group { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 12px; }
    .hero-left .hero-guarantee { display: flex; align-items: center; gap: 8px; font-size: 0.85rem; color: #525252; }
    .hero-left .hero-guarantee strong { color: #F86000; }
    .hero-channels {
      display: flex; gap: 8px; margin-top: 14px;
    }
    .hero-channels span {
      display: inline-flex; align-items: center; gap: 4px;
      font-size: 0.75rem; color: #A3A3A3;
      background: #F5F5F5; padding: 4px 10px; border-radius: 6px;
      border: 1px solid #E5E5E5;
    }

    /* Hero Simulator (right) */
    #hero-sim {
      width: 100%; height: 420px; position: relative;
      border-radius: 20px; overflow: hidden;
      background: #1A1A1A; box-shadow: 0 20px 60px rgba(0,0,0,0.15);
    }
    #hero-sim canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
    .sim-term { position: absolute; z-index: 5; background: rgba(26,26,26,0.92); border: 1px solid rgba(255,255,255,0.08); border-radius: 10px; overflow: hidden; backdrop-filter: blur(4px); width: 300px; font-family: 'SF Mono','JetBrains Mono',monospace; font-size: 0.68rem; color: #D4D4D4; opacity: 0; transition: opacity 1s ease; }
    .sim-term.shown { opacity: 1; }
    .sim-term .dots { display: flex; gap: 5px; padding: 6px 10px; background: rgba(255,255,255,0.04); border-bottom: 1px solid rgba(255,255,255,0.06); }
    .sim-term .dots span { width: 7px; height: 7px; border-radius: 50%; }
    .sim-term .dots span:nth-child(1) { background: #FF5F56; }
    .sim-term .dots span:nth-child(2) { background: #FFBD2E; }
    .sim-term .dots span:nth-child(3) { background: #27C93F; }
    .sim-term .label { position: absolute; top: 5px; right: 10px; font-size: 0.5rem; font-weight: 600; letter-spacing: 0.04em; opacity: 0.5; color: #F86000; }
    .sim-term .body { padding: 8px 10px; min-height: 100px; line-height: 1.6; font-size: 0.65rem; }
    #term-main { top: 50%; left: 50%; transform: translate(-50%,-50%); }
    .sim-prompt { color: #F86000; }
    .sim-bar { position: absolute; bottom: 6px; left: 50%; transform: translateX(-50%); z-index: 5; display: flex; gap: 14px; align-items: center; background: rgba(0,0,0,0.5); backdrop-filter: blur(6px); border: 1px solid rgba(255,255,255,0.06); border-radius: 6px; padding: 4px 12px; }
    .sim-bar .stat { display: flex; align-items: center; gap: 4px; font-size: 0.6rem; color: #858585; }
    .sim-bar .stat .num { color: #fff; font-weight: 600; }
    .sim-bar .stat .live-dot { width: 4px; height: 4px; background: #27C93F; border-radius: 50%; animation: pulse 1.5s ease-in-out infinite; }
    @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.3} }
    @keyframes blink { 50% { opacity: 0; } }
    .sim-tools { position: absolute; z-index: 5; display: flex; gap: 6px; bottom: 38px; justify-content: center; width: 100%; opacity: 0; transition: opacity 1s ease; }
    .sim-tools.shown { opacity: 1; }
    .sim-tool { font-family: 'SF Mono','JetBrains Mono',monospace; font-size: 0.55rem; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.06); border-radius: 4px; padding: 2px 8px; color: #737373; }

    /* Steps (Job to be done) */
    .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 40px; }
    .step-card { text-align: center; padding: 32px 20px; background: #fff; border: 1px solid #E5E5E5; border-radius: 16px; }
    .step-card .step-icon { margin: 0 auto 16px; } .step-card p { font-size: 0.9rem; }
    .step-card .arrow { color: #A3A3A3; font-size: 0.75rem; margin-top: 4px; }

    /* Scarcity */
    .scarcity-bar { max-width: 600px; margin: 24px auto 0; text-align: center; background: #FFF8F0; border: 1px solid #FED7AA; border-radius: 12px; padding: 16px 24px; }
    .scarcity-bar p { font-size: 0.9rem; color: #9A3412; font-weight: 500; }
    .scarcity-bar .highlight { color: #F86000; font-weight: 700; }

    /* Duo Icons */
    .duo-icon { display: inline-flex; align-items: center; justify-content: center; width: 48px; height: 48px; flex-shrink: 0; }
    .duo-icon svg { width: 48px; height: 48px; }
    .duo-icon.sm svg { width: 32px; height: 32px; } .duo-icon.sm { width: 32px; height: 32px; }
    .duo-icon.xs svg { width: 20px; height: 20px; } .duo-icon.xs { width: 20px; height: 20px; }

    /* Terminal card */
    .terminal-card { max-width: 720px; margin: 0 auto; background: #1A1A1A; border-radius: 16px; overflow: hidden; box-shadow: 0 20px 60px rgba(0,0,0,0.12); text-align: left; opacity: 0; transform: translateY(30px); transition: opacity 0.8s ease, transform 0.8s ease; }
    .terminal-card.visible { opacity: 1; transform: translateY(0); }
    .terminal-dots { display: flex; gap: 8px; padding: 14px 20px; background: #262626; border-bottom: 1px solid #333; }
    .terminal-dot { width: 12px; height: 12px; border-radius: 50%; }
    .terminal-dot.r { background: #FF5F56; } .terminal-dot.y { background: #FFBD2E; } .terminal-dot.g { background: #27C93F; }
    .terminal-body { padding: 20px 24px; font-family: 'SF Mono', 'JetBrains Mono', monospace; font-size: 0.85rem; line-height: 1.8; color: #D4D4D4; min-height: 200px; }
    .term-line { margin-bottom: 6px; display: flex; gap: 10px; }
    .term-line .prompt { flex-shrink: 0; }
    .term-line .prompt.orange { color: #F86000; }
    .term-line .prompt.green { color: #27C93F; }
    .term-line .prompt.blue { color: #6CB6FF; }
    .term-line .text { color: #D4D4D4; }
    .term-line .text.gray { color: #858585; }
    .term-line .text.green { color: #27C93F; }
    .term-line .text.blue { color: #6CB6FF; }
    .typing-cursor { animation: blink 0.8s step-end infinite; color: #D4D4D4; }

    /* Story */
    .story-card { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; margin-bottom: 80px; }
    .story-card:last-child { margin-bottom: 0; } .story-card.reverse .text { order: 1; } .story-card.reverse img { order: 0; }
    .story-card .badge { display: inline-block; background: #F5F5F5; padding: 4px 12px; border-radius: 100px; font-size: 0.75rem; color: #525252; margin-bottom: 12px; border: 1px solid #E5E5E5; }
    .story-card .blog-link { display: inline-flex; align-items: center; gap: 6px; font-size: 0.9rem; color: #F86000; font-weight: 500; text-decoration: none; }
    .story-card .blog-link:hover { text-decoration: underline; }
    .story-card img { border-radius: 16px; box-shadow: 0 12px 40px rgba(0,0,0,0.06); }
    /* Features */
    .feature-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 40px; }
    .feature-card { background: #fff; border: 1px solid #E5E5E5; border-radius: 16px; padding: 28px; transition: all 0.2s; text-align: center; }
    .feature-card:hover { box-shadow: 0 8px 32px rgba(0,0,0,0.06); }
    .feature-card .card-icon { margin: 0 auto 16px; } .feature-card h3 { margin-bottom: 8px; } .feature-card p { font-size: 0.9rem; }
    /* Modules */
    .modules { display: grid; gap: 16px; margin-top: 40px; }
    .module-row { display: flex; align-items: center; gap: 20px; padding: 20px 24px; background: #fff; border: 1px solid #E5E5E5; border-radius: 12px; transition: all 0.2s; }
    .module-row:hover { border-color: #F86000; box-shadow: 0 4px 16px rgba(248,96,0,0.08); }
    .module-num { width: 40px; height: 40px; border-radius: 10px; background: #F5F5F5; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 1.1rem; flex-shrink: 0; }
    .module-num.active { background: #F86000; color: #fff; }
    .module-row .info { flex: 1; } .module-row .info h3 { font-size: 1rem; margin-bottom: 2px; } .module-row .info p { font-size: 0.85rem; color: #737373; }
    /* Compare */
    .compare-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 40px; }
    .compare-card { background: #fff; border: 1px solid #E5E5E5; border-radius: 16px; padding: 32px 24px; text-align: center; position: relative; }
    .compare-card.featured { border-color: #F86000; box-shadow: 0 8px 32px rgba(248,96,0,0.08); }
    .compare-card .cmp-icon { margin: 0 auto 16px; } .compare-card h3 { margin-bottom: 4px; }
    .compare-card .subtitle { font-size: 0.8rem; color: #A3A3A3; margin-bottom: 20px; }
    .compare-card ul { text-align: left; list-style: none; }
    .compare-card ul li { padding: 8px 0; font-size: 0.85rem; display: flex; align-items: center; gap: 10px; border-bottom: 1px solid #F5F5F5; }
    .compare-card ul li:last-child { border-bottom: none; }
    .compare-card ul li .li-icon { flex-shrink: 0; }
    .compare-card .cmp-badge { position: absolute; top: -12px; left: 50%; transform: translateX(-50%); background: #F86000; color: #fff; padding: 4px 14px; border-radius: 100px; font-size: 0.7rem; font-weight: 600; white-space: nowrap; text-transform: uppercase; letter-spacing: 0.05em; }
    /* Pricing */
    .pricing-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 40px; align-items: start; }
    .pricing-3-card { background: #fff; border: 1px solid #E5E5E5; border-radius: 16px; padding: 32px 24px; text-align: center; position: relative; }
    .pricing-3-card.featured { border-color: #F86000; box-shadow: 0 12px 48px rgba(248,96,0,0.1); transform: scale(1.05); }
    .pricing-3-card .p-name { font-size: 0.9rem; font-weight: 600; color: #525252; margin-bottom: 4px; }
    .pricing-3-card .p-price { font-size: 2.4rem; font-weight: 700; color: #F86000; margin: 8px 0; }
    .pricing-3-card .p-price-sub { font-size: 0.8rem; color: #A3A3A3; margin-bottom: 16px; }
    .pricing-3-card .btn-primary { width: 100%; justify-content: center; padding: 12px; font-size: 0.95rem; }
    .pricing-3-card ul { text-align: left; margin: 20px 0; list-style: none; }
    .pricing-3-card ul li { padding: 7px 0; font-size: 0.85rem; display: flex; align-items: center; gap: 8px; border-bottom: 1px solid #F5F5F5; }
    .pricing-3-card ul li:last-child { border-bottom: none; }
    .pricing-3-card .p-badge { position: absolute; top: -12px; left: 50%; transform: translateX(-50%); background: #F86000; color: #fff; padding: 4px 14px; border-radius: 100px; font-size: 0.7rem; font-weight: 600; white-space: nowrap; text-transform: uppercase; letter-spacing: 0.05em; }
    .pricing-3-card .p-badge.best { background: #0A0A0A; }
    .pricing-3-card .bonus-row { background: #FFF8F0; border: 1px solid #FED7AA; border-radius: 10px; padding: 12px 16px; margin: 16px 0; font-size: 0.8rem; text-align: left; }
    .pricing-3-card .bonus-row strong { color: #9A3412; }
    /* FAQ */
    .faq-list { max-width: 700px; margin: 0 auto; }
    .faq-item { border-bottom: 1px solid #E5E5E5; padding: 20px 0; }
    .faq-q { font-weight: 600; font-size: 1rem; cursor: pointer; display: flex; justify-content: space-between; align-items: center; }
    .faq-q::after { content: "+"; font-size: 1.3rem; color: #A3A3A3; }
    .faq-a { margin-top: 12px; font-size: 0.9rem; color: #737373; display: none; }
    .faq-item.open .faq-a { display: block; }
    .faq-item.open .faq-q::after { content: "−"; }
    .cta-final { text-align: center; padding: 80px 0; }
    .cta-final h2 { margin-bottom: 16px; } .cta-final p { max-width: 500px; margin: 0 auto 32px; }
    footer { text-align: center; padding: 40px 0; border-top: 1px solid #E5E5E5; font-size: 0.85rem; color: #A3A3A3; }

    @media (max-width: 768px) {
      .hero-split { grid-template-columns: 1fr; gap: 32px; }
      .hero-left { text-align: center; }
      .hero-left .cta-group { justify-content: center; }
      .hero-left .hero-guarantee { justify-content: center; }
      .hero-channels { justify-content: center; }
      header .container { flex-wrap: nowrap; gap: 8px; }
      .logo span { display: none; }
      header .btn-primary { padding: 8px 14px !important; font-size: 0.8rem !important; white-space: nowrap; }
      .story-card { grid-template-columns: 1fr; gap: 24px; }
      .feature-grid { grid-template-columns: 1fr; } .steps { grid-template-columns: 1fr; }
      .compare-3 { grid-template-columns: 1fr; } .pricing-3 { grid-template-columns: 1fr; } .pricing-3-card.featured { transform: none; }
      section { padding: 60px 0; }
      #hero-sim { height: 340px; }
      .sim-term { width: 260px; font-size: 0.75rem !important; }
      .sim-term .body { font-size: 0.72rem !important; }
    }
    @media (max-width: 400px) {
      header .btn-primary { padding: 6px 10px !important; font-size: 0.75rem !important; }
      .logo img { height: 22px; } #hero-sim { height: 280px; }
      .sim-term { width: 200px; font-size: 0.7rem !important; }
      .sim-term .body { font-size: 0.65rem !important; }
    }
  </style>
</head>
<body>

<!-- HEADER -->
<header>
  <div class="container">
    <a href="/" class="logo">
      <img src={logoImg} alt="David Tùng" />
      <img src={hermesLogo} alt="Hermes" style="height:24px;margin-left:4px" />
      <span>David Tùng</span>
    </a>
    <a href="#pricing" class="btn-primary" style="padding:10px 20px;font-size:0.9rem">Nhận trợ lý →</a>
  </div>
</header>

<!-- ===== HERO: LEFT TEXT + RIGHT SIMULATOR ===== -->
<section class="hero dotted-bg">
  <div class="container hero-split">
    <!-- LEFT: Text -->
    <div class="hero-left">
      <div class="hero-badge">
        <img src={hermesLogo} alt="Hermes" /> Tự tiến hóa &bull; Làm việc &bull; Đóng gói skill
      </div>
      <h1>
        Bạn đang chat với AI <span class="text-orange">hàng giờ</span> —<br>
        mà vẫn <span class="text-muted">tự làm hết mọi việc?</span>
      </h1>
      <p class="sub">
        <strong>300 câu hỏi với ChatGPT. 0 công việc hoàn thành.</strong><br>
        Hermes là trợ lý thực thi: nhận việc → dùng tool → tạo output → kiểm tra → đóng gói skill.
        <strong>Không bán công cụ — trao giá trị cách sử dụng.</strong>
      </p>
      <p style="font-size:0.85rem;color:#A3A3A3;margin-bottom:20px;line-height:1.5">
        <strong style="color:#0A0A0A">Dành cho:</strong> CEO / chủ DN 1 người — đã thử ChatGPT, thấy nhanh hơn nhưng vẫn tự làm hết.
        <br><strong style="color:#0A0A0A">Không dành cho:</strong> người muốn AI làm chủ — bạn vẫn là người ra quyết định.
      </p>
      <div class="cta-group">
        <a href="#pricing" class="btn-primary" style="padding:16px 36px;font-size:1.1rem">Nhận trọn bộ — từ 699k →</a>
        <a href="#demo" class="btn-secondary">Xem đang chạy ▸</a>
      </div>
      <div class="hero-guarantee">
        <span>🛡️</span> 30 ngày hoàn tiền — <strong>không cần lý do</strong>
      </div>
      <div class="hero-channels">
        <span>💬 Telegram</span>
        <span>📱 WhatsApp</span>
        <span>🖥️ Terminal</span>
        <span>📧 Email</span>
      </div>
    </div>

    <!-- RIGHT: Simulator -->
    <div>
      <div id="hero-sim">
        <canvas id="sim-canvas"></canvas>
        <div class="sim-term" id="term-main">
          <div class="dots"><span></span><span></span><span></span></div>
          <div class="label">HERMES</div>
          <div class="body" id="term-body"></div>
        </div>
        <div class="sim-tools" id="sim-tools">
          <span class="sim-tool">📁 File</span>
          <span class="sim-tool">📧 Email</span>
          <span class="sim-tool">🤖 AI</span>
          <span class="sim-tool">💬 Telegram</span>
        </div>
        <div class="sim-bar">
          <div class="stat"><span class="live-dot"></span> Live</div>
          <div class="stat">Tác vụ: <span class="num" id="sim-tasks">12</span></div>
          <div class="stat">Skill: <span class="num" id="sim-skills">4</span></div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ===== SECTION 2: JOB TO BE DONE ===== -->
<section id="solution" class="alt">
  <div class="container">
    <div class="section-header" style="text-align:center;margin:0 auto 48px">
      <div class="section-label" style="color:#F86000">✦ Job to be done</div>
      <h2>Từ Q&A đến việc hoàn thành</h2>
      <p>Hầu hết doanh nghiệp đang dùng AI ở cấp "hỏi — đáp". Hermes đưa bạn lên cấp "hoàn thành công việc".</p>
    </div>
    <div style="max-width:800px;margin:0 auto">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:40px">
        <div style="background:#fff;border:1px solid #E5E5E5;border-radius:12px;padding:20px 24px">
          <div style="font-size:0.75rem;font-weight:600;text-transform:uppercase;letter-spacing:0.08em;color:#A3A3A3;margin-bottom:8px">❌ Q&A (thường thấy)</div>
