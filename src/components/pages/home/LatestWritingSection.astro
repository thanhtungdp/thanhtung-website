---
import BlogPostCard from '../../blog/BlogPostCard.astro';
import ButtonLink from '../../ui/ButtonLink.astro';
import SectionHeading from './SectionHeading.astro';
import { getTranslations, localizePath, type Locale } from '../../../i18n';
import { type BlogPost } from '../../../lib/blog';

interface Props {
	locale: Locale;
	isVi: boolean;
	posts: BlogPost[];
}

const { locale, isVi, posts } = Astro.props;
const t = getTranslations(locale);
---

<section class="relative py-8">
	<div class="flex items-center justify-between py-2">
		<SectionHeading kicker={isVi ? 'Ghi chú thực thi' : 'Execution notes'} title={isVi ? 'Bài học từ AI, sản phẩm và vận hành' : 'Lessons from AI, product, and operations'} />
		<ButtonLink class="max-sm:w-full" href={localizePath('/blog', locale)} variant="secondary" size="compact">
			{isVi ? 'Xem tất cả ghi chú' : 'View all notes'}
		</ButtonLink>
	</div>

	<div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
		{
			posts.map((post) => (
				<BlogPostCard post={post} locale={locale} readMoreLabel={t.blog.readMore} headingLevel="h3" />
			))
		}
	</div>
</section>
