---
import BaseHead from '../components/BaseHead.astro';
import { Image } from 'astro:assets';
import portrait from '../assets/blog-placeholder-about.jpg';

const NAV = [
	{ label: 'Frameworks', href: '#x10' },
	{ label: 'Work', href: '#work' },
	{ label: 'Services', href: '#services' },
	{ label: 'Insights', href: '#insights' },
];

const STATS = [
	{ value: '12 năm', label: 'Xây sản phẩm thật' },
	{ value: '1M+', label: 'Học viên trên YouTube' },
	{ value: '100+', label: 'Doanh nghiệp dùng Simplamo' },
	{ value: '2,000+', label: 'Đại lý dùng Austdoor Sale AI' },
];

const PILLARS = [
	{
		id: '01',
		name: 'DATA — Nền móng',
		body:
			'ERP, IoT và CRM tích hợp về một nguồn duy nhất. Không có lớp dữ liệu sạch, mọi AI Agent đều vô dụng.',
		bullets: [
			'Odoo + MCP làm xương sống',
			'Realtime dashboard 3 cấp',
			'Bằng chứng: 1.000+ trạm iLotusLand',
		],
	},
	{
		id: '02',
		name: 'AI — Khuếch đại',
		body:
			'AI Agent có quyền hành động, gọi tool, ghi vào ERP. Không phải chatbot — là tác nhân chạy thật trong sản xuất.',
		bullets: [
			'LangGraph + MCP stack',
			'80% tự động, 20% human review',
			'Bằng chứng: Austdoor Sale AI',
		],
	},
	{
		id: '03',
		name: 'COACHING — Kỷ luật',
		body:
			'OKRs gắn BSC-KPI, nhịp đập tuần do CEO trực tiếp dẫn dắt. Không có nhịp này, Data và AI nằm im.',
		bullets: [
			'4DX + Same-Page Meeting',
			'12 buổi họp tuần/quý',
			'Bằng chứng: 100+ tổ chức Simplamo',
		],
	},
];

const WORK = [
	{
		stat: '1,000+',
		statLabel: 'Trạm quan trắc realtime',
		title: 'iLotusLand — Nền tảng IoT công nghiệp #1 Việt Nam',
		body:
			'Sao Khuê 2023. 600+ nhà máy FDI gồm Coca-Cola, Toyota, Vinamilk. Xuất khẩu sang 15 quốc gia.',
		href: '/work/ilotusland',
	},
	{
		stat: '100+',
		statLabel: 'Doanh nghiệp dùng hàng tuần',
		title: 'Simplamo — Thực thi chiến lược với AI Agent',
		body:
			'Doanh thu × 1.3–1.5/năm. Họp dư thừa giảm 45%. AI Agent tự sinh OKRs/KPIs.',
		href: '/work/simplamo',
	},
	{
		stat: '2,000+',
		statLabel: 'Đại lý phục vụ 24/7',
		title: 'Austdoor Sale AI — AI Agent production cho ADG',
		body:
			'Thời gian báo giá từ 4 giờ xuống 30 giây. Stack: NestJS + LangGraph + MCP.',
		href: '/work/austdoor-sale-ai',
	},
];

const SERVICES = [
	{
		id: 'GÓI 01',
		title: 'Coaching CEO theo OKRs',
		body: 'Một nhịp đập tuần. Một kết quả quý. Tỉ lệ hoàn thành OKR ≥ 80% sau 1 quý.',
		href: '/services/coaching-okrs',
		featured: false,
	},
	{
		id: 'GÓI 02',
		title: 'Tech Roadmap 18 tháng',
		body: 'Lộ trình công nghệ đủ rõ cho CEO, đủ chi tiết cho CIO. Tiết kiệm 30% so vendor chào.',
		href: '/services/tech-roadmap',
		featured: false,
	},
	{
		id: 'GÓI 03',
		title: 'AI Solution riêng cho mô hình của anh',
		body: 'Từ AI demo đến AI sản xuất. Production-grade, có observability, có audit log.',
		href: '/services/ai-solution',
		featured: false,
	},
	{
		id: 'GÓI 04',
		title: 'Executive Training — Chiến lược, AI, Công nghệ',
		body: 'Workshop 2 ngày cho board/CEO. Khung tư duy để không bị bỏ lại trong cuộc đua AI.',
		href: '/services/executive-training',
		featured: false,
	},
	{
		id: 'GÓI 05',
		title: 'X10 — Triển khai trọn gói 90 ngày',
		body:
			'Data + AI + Coaching cùng lúc. Cam kết KPI trong hợp đồng. Chỉ nhận 4 khách/năm.',
		href: '/services/x10',
		featured: true,
	},
];

const INSIGHTS = [
	{
		topic: 'STRATEGY',
		title: 'Tại sao 70% chuyển đổi số tại Việt Nam thất bại',
		excerpt:
			'Không phải vì thiếu công nghệ — vì doanh nghiệp giải sai bài toán: coi công nghệ là mục đích, không phải công cụ.',
		date: '14 Tháng 6, 2026',
		readTime: '6 min',
		href: '/insights/why-vietnam-digital-transformation-fails',
	},
	{
		topic: 'AI',
		title: 'MCP là gì và vì sao mọi AI Agent doanh nghiệp phải dùng',
		excerpt:
			'Model Context Protocol mở cánh cửa cho AI Agent gọi vào ERP/CRM một cách an toàn — đây là lớp hạ tầng còn thiếu.',
		date: '8 Tháng 6, 2026',
		readTime: '9 min',
		href: '/insights/mcp-for-enterprise-ai',
	},
	{
		topic: 'COACHING',
		title: 'Same-Page Meeting: bí mật 90 phút giúp CEO không quá tải',
		excerpt:
			'Một buổi họp tuần đúng chuẩn 4DX có thể thay thế 5 buổi meeting rời rạc. Đây là cấu trúc chúng tôi dùng tại Simplamo.',
		date: '1 Tháng 6, 2026',
		readTime: '5 min',
		href: '/insights/same-page-meeting',
	},
];

const PARTNERS = ['BNI Vietnam', 'ActionCOACH', 'Vistage', 'TopDev', 'Shark Tank Forum', 'Sao Khuê 2023'];
---

<!doctype html>
<html lang="vi">
	<head>
		<BaseHead
			title="Phan Thanh Tùng (David Tung) — Simple Technology enables X10 Operations"
			description="Tôi giúp CEO doanh nghiệp 1.000+ tỷ VND tăng trưởng gấp 10 bằng Data × AI × Coaching. Co-founder Simplamo và iLotusLand."
			locale="vi"
		/>
		<style>
			:root {
				--brand-orange: #f26c2c;
				--brand-orange-soft: #fff1e8;
				--brand-navy: #1a2b4a;
				--brand-navy-soft: #2a3d5f;
				--brand-bg: #ffffff;
			}

			.preview-root {
				font-family: var(--font-atkinson), ui-sans-serif, system-ui, -apple-system, sans-serif;
				color: #1f2937;
				background: #ffffff;
			}

			.preview-root h1,
			.preview-root h2,
			.preview-root h3,
			.preview-root .display {
				font-family: 'Fraunces', Georgia, 'Times New Roman', serif;
				letter-spacing: -0.025em;
			}

			.brand-orange { color: var(--brand-orange); }
			.brand-navy { color: var(--brand-navy); }
			.bg-brand-orange { background: var(--brand-orange); }
			.bg-brand-orange-soft { background: var(--brand-orange-soft); }
			.bg-brand-navy { background: var(--brand-navy); }
			.border-brand-orange { border-color: var(--brand-orange); }

			.btn-primary {
				display: inline-flex;
				align-items: center;
				gap: 8px;
				padding: 14px 24px;
				background: var(--brand-orange);
				color: white;
				border-radius: 999px;
				font-weight: 600;
				font-size: 15px;
				text-decoration: none;
				transition: all 200ms;
				box-shadow: 0 8px 24px rgba(242, 108, 44, 0.25);
			}
			.btn-primary:hover {
				transform: translateY(-2px);
				box-shadow: 0 14px 32px rgba(242, 108, 44, 0.32);
				color: white;
			}

			.btn-secondary {
				display: inline-flex;
				align-items: center;
				gap: 8px;
				padding: 14px 24px;
				background: transparent;
				color: var(--brand-navy);
				border: 1.5px solid var(--brand-navy);
				border-radius: 999px;
				font-weight: 600;
				font-size: 15px;
				text-decoration: none;
				transition: all 200ms;
			}
			.btn-secondary:hover {
				background: var(--brand-navy);
				color: white;
				transform: translateY(-2px);
			}

			.eyebrow {
				display: inline-block;
				color: var(--brand-orange);
				font-size: 12px;
				font-weight: 700;
				letter-spacing: 0.14em;
				text-transform: uppercase;
			}

			.section {
				padding: 96px 0;
			}
			@media (max-width: 768px) {
				.section { padding: 56px 0; }
			}

			.container-x {
				max-width: 1200px;
				margin: 0 auto;
				padding: 0 24px;
			}
			@media (min-width: 768px) {
				.container-x { padding: 0 48px; }
			}

			/* Hero photo card */
			.hero-portrait {
				position: relative;
				border-radius: 24px;
				overflow: hidden;
				box-shadow: 0 30px 60px rgba(26, 43, 74, 0.18);
			}
			.hero-portrait::after {
				content: "";
				position: absolute;
				inset: 0;
				background: linear-gradient(180deg, transparent 50%, rgba(26, 43, 74, 0.4));
			}
			.hero-floating-card {
				position: absolute;
				bottom: -32px;
				right: -16px;
				background: white;
				padding: 20px 24px;
				border-radius: 16px;
				box-shadow: 0 20px 50px rgba(15, 23, 42, 0.15);
				z-index: 2;
				max-width: 240px;
			}

			@media (max-width: 768px) {
				.hero-floating-card {
					right: 16px;
					bottom: -24px;
					padding: 16px 20px;
				}
			}

			/* Header */
			.preview-header {
				position: sticky;
				top: 0;
				z-index: 50;
				backdrop-filter: blur(10px);
				background: rgba(255, 255, 255, 0.86);
				border-bottom: 1px solid rgba(0, 0, 0, 0.04);
			}

			/* X10 formula */
			.x10-formula {
				font-family: 'Fraunces', serif;
				font-size: clamp(28px, 5vw, 56px);
				font-weight: 700;
				letter-spacing: -0.02em;
				text-align: center;
			}
			.x10-formula .op {
				color: #9ca3af;
				font-size: 0.65em;
				vertical-align: 0.15em;
				margin: 0 0.3em;
			}
			.x10-formula .x10-result {
				color: var(--brand-orange);
				font-size: 1.2em;
				margin-left: 0.2em;
			}

			/* Card hover */
			.card-hover {
				transition: all 220ms ease;
			}
			.card-hover:hover {
				transform: translateY(-4px);
				box-shadow: 0 24px 48px rgba(15, 23, 42, 0.1);
				border-color: var(--brand-orange) !important;
			}

			/* Fade up animation */
			@keyframes fadeUp {
				from { opacity: 0; transform: translateY(24px); }
				to { opacity: 1; transform: translateY(0); }
			}
			.fade-up {
				animation: fadeUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
			}
			.fade-up-1 { animation-delay: 0.05s; }
			.fade-up-2 { animation-delay: 0.15s; }
			.fade-up-3 { animation-delay: 0.25s; }
			.fade-up-4 { animation-delay: 0.35s; }

			@media (prefers-reduced-motion: reduce) {
				.fade-up, .fade-up-1, .fade-up-2, .fade-up-3, .fade-up-4 {
					animation: none;
				}
			}
		</style>
	</head>
	<body class="preview-root">
		<!-- ============ HEADER ============ -->
		<header class="preview-header">
			<div class="container-x flex h-[72px] items-center justify-between">
				<a href="/preview" class="flex items-center gap-0 text-[22px] font-bold tracking-tight">
					<span class="brand-navy" style="font-family: 'Fraunces', serif;">David</span>
					<span class="brand-orange ml-1.5" style="font-family: 'Fraunces', serif;">Tung</span>
				</a>
				<nav class="hidden items-center gap-8 md:flex">
					{NAV.map((n) => (
						<a href={n.href} class="text-sm font-medium text-gray-700 transition-colors hover:text-[var(--brand-orange)]">{n.label}</a>
					))}
					<a href="#book" class="btn-primary" style="padding: 10px 18px; font-size: 14px;">Book a call</a>
				</nav>
				<button class="md:hidden text-gray-700" aria-label="Menu">
					<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
				</button>
			</div>
		</header>

		<!-- ============ SECTION 1: HERO ============ -->
		<section class="container-x pt-16 pb-24 md:pt-24 md:pb-32">
			<div class="grid items-center gap-16 md:grid-cols-12 md:gap-12">
				<div class="md:col-span-7">
					<p class="eyebrow fade-up fade-up-1">Tech Visionary · Serial Founder · Coach</p>
					<h1 class="mt-5 text-[44px] font-semibold leading-[1.05] md:text-[72px] fade-up fade-up-2 brand-navy">
						Simple Technology<br />enables <span class="brand-orange">X10</span> Operations
					</h1>
					<p class="mt-7 max-w-[560px] text-[17px] leading-[1.65] text-gray-600 md:text-[20px] fade-up fade-up-3">
						Tôi giúp CEO doanh nghiệp 1.000+ tỷ VND tăng trưởng gấp 10 bằng công thức <span class="brand-navy font-semibold">Data × AI × Coaching</span> — đã kiểm chứng tại iLotusLand, Simplamo và Austdoor.
					</p>
					<div class="mt-9 flex flex-wrap gap-4 fade-up fade-up-4">
						<a href="#book" class="btn-primary">
							Đặt cuộc gặp 30 phút
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
						</a>
						<a href="#x10" class="btn-secondary">Tải X10 Whitepaper</a>
					</div>
					<div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-2 text-[14px] text-gray-500 fade-up fade-up-4">
						<span class="flex items-center gap-1.5"><span class="brand-orange">✓</span> Miễn phí 30 phút</span>
						<span class="flex items-center gap-1.5"><span class="brand-orange">✓</span> Không bán hàng</span>
						<span class="flex items-center gap-1.5"><span class="brand-orange">✓</span> Phản hồi trong 24h</span>
					</div>
				</div>

				<div class="md:col-span-5 fade-up fade-up-3">
					<div class="relative">
						<div class="hero-portrait" style="aspect-ratio: 4/5;">
							<Image src={portrait} alt="Phan Thanh Tùng — Co-founder Simplamo và iLotusLand" widths={[400, 800]} sizes="(max-width: 768px) 100vw, 480px" class="h-full w-full object-cover" loading="eager" />
						</div>
						<div class="hero-floating-card fade-up fade-up-4">
							<p class="eyebrow text-[10px]">IN PRODUCTION</p>
							<p class="mt-2 brand-navy text-[16px] font-bold leading-snug">2 AI Agents</p>
							<p class="text-[13px] text-gray-600">100+ companies</p>
							<p class="text-[13px] text-gray-600">2,000+ dealers</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- ============ SECTION 2: STAT BAND ============ -->
		<section class="bg-brand-navy py-16 md:py-24">
			<div class="container-x">
				<div class="grid grid-cols-2 gap-10 md:grid-cols-4 md:gap-8">
					{STATS.map((s) => (
						<div class="text-center">
							<div class="display text-[44px] font-bold leading-none brand-orange md:text-[64px]">{s.value}</div>
							<div class="mt-3 text-[14px] font-medium text-white opacity-90 md:text-[16px]">{s.label}</div>
						</div>
					))}
				</div>
			</div>
		</section>

		<!-- ============ SECTION 3: X10 FRAMEWORK ============ -->
		<section id="x10" class="section">
			<div class="container-x">
				<div class="mx-auto max-w-[640px] text-center">
					<p class="eyebrow">Khung vận hành</p>
					<h2 class="mt-4 text-[32px] font-semibold leading-tight brand-navy md:text-[44px]">Công thức X10</h2>
					<p class="mt-5 text-[18px] leading-relaxed text-gray-600 md:text-[20px]">
						12 năm vận hành 3 nền tảng đã đúc kết thành một phép nhân đơn giản. Bỏ bất kỳ vế nào, kết quả về 0.
					</p>
				</div>

				<div class="mt-16 px-4">
					<p class="x10-formula brand-navy">
						<span>DATA</span><span class="op">×</span><span>AI</span><span class="op">×</span><span>COACHING</span><span class="op">=</span><span class="x10-result">X10</span>
					</p>
				</div>

				<div class="mt-20 grid gap-6 md:grid-cols-3">
					{PILLARS.map((p) => (
						<div class="rounded-2xl bg-gray-50 p-8 border-t-4 border-brand-orange">
							<p class="eyebrow text-[14px]">{p.id}</p>
							<h3 class="mt-3 text-[24px] font-semibold leading-tight brand-navy">{p.name}</h3>
							<p class="mt-4 text-[16px] leading-relaxed text-gray-700">{p.body}</p>
							<ul class="mt-5 space-y-2">
								{p.bullets.map((b) => (
									<li class="flex items-start gap-2 text-[14px] text-gray-600">
										<span class="brand-orange mt-0.5">→</span>{b}
									</li>
								))}
							</ul>
						</div>
					))}
				</div>

				<div class="mt-16 text-center">
					<a href="/frameworks/x10" class="btn-secondary">
						Đọc X10 Whitepaper đầy đủ
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
					</a>
				</div>
			</div>
		</section>

		<!-- ============ SECTION 4: SELECTED WORK ============ -->
		<section id="work" class="section bg-gray-50">
			<div class="container-x">
				<div class="max-w-[720px]">
					<p class="eyebrow">Selected Work</p>
					<h2 class="mt-4 text-[32px] font-semibold leading-tight brand-navy md:text-[44px]">
						Ba sản phẩm. Hàng nghìn người dùng thật.
					</h2>
					<p class="mt-5 text-[18px] text-gray-600">
						Click vào từng case để xem bối cảnh, vấn đề, giải pháp và kết quả số.
					</p>
				</div>

				<div class="mt-14 grid gap-8 md:grid-cols-3">
					{WORK.map((w) => (
						<a href={w.href} class="card-hover block rounded-2xl border border-gray-200 bg-white p-8">
							<div class="display text-[48px] font-bold leading-none brand-orange md:text-[56px]">{w.stat}</div>
							<div class="mt-2 text-[14px] font-medium text-gray-600">{w.statLabel}</div>
							<h3 class="mt-6 text-[20px] font-semibold leading-snug brand-navy">{w.title}</h3>
							<p class="mt-3 text-[15px] leading-relaxed text-gray-700">{w.body}</p>
							<p class="mt-5 text-[14px] font-semibold brand-orange">Xem case study →</p>
						</a>
					))}
				</div>

				<div class="mt-12 text-center">
					<a href="/work" class="text-[15px] font-semibold brand-orange hover:underline">Xem tất cả case studies →</a>
				</div>
			</div>
		</section>

		<!-- ============ SECTION 5: SERVICES ============ -->
		<section id="services" class="section">
			<div class="container-x">
				<div class="max-w-[720px]">
					<p class="eyebrow">Services</p>
					<h2 class="mt-4 text-[32px] font-semibold leading-tight brand-navy md:text-[44px]">
						Năm cách tôi giúp anh chạy gấp 10
					</h2>
					<p class="mt-5 text-[18px] text-gray-600">
						Từ coaching CEO 1-1 đến triển khai trọn gói 90 ngày. Mỗi gói đều cam kết KPI trong hợp đồng.
					</p>
				</div>

				<div class="mt-14 grid gap-6 md:grid-cols-3">
					{SERVICES.slice(0, 3).map((s) => (
						<a href={s.href} class={`card-hover block rounded-2xl border p-7 ${s.featured ? 'border-brand-orange bg-brand-navy text-white' : 'border-gray-200 bg-white'}`}>
							<p class="eyebrow text-[11px]">{s.id}</p>
							<h3 class={`mt-3 text-[20px] font-semibold leading-snug ${s.featured ? 'text-white' : 'brand-navy'}`}>{s.title}</h3>
							<p class={`mt-3 text-[15px] leading-relaxed ${s.featured ? 'text-gray-300' : 'text-gray-700'}`}>{s.body}</p>
							<p class={`mt-5 text-[14px] font-semibold ${s.featured ? 'text-[var(--brand-orange)]' : 'brand-orange'}`}>Xem chi tiết →</p>
						</a>
					))}
				</div>

				<div class="mt-6 grid gap-6 md:mx-auto md:max-w-[800px] md:grid-cols-2">
