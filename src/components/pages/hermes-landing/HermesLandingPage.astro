---
import BaseHead from '../../BaseHead.astro';
import { Image } from 'astro:assets';
import DavidTungLogo from '../../../assets/david-tung-logo-upload.png';
import HermesIcon from '../../../assets/hermes-landing/icon.png';
import HermesOgImage from '../../../assets/hermes-landing/featured.png';
import HeroAnimatedBackground from './HeroAnimatedBackground.astro';
import LiveChat from './LiveChat';
import FlowDiagram from './FlowDiagram';
import VideoShowcase from './VideoShowcase';
import CheckOutModal from '../../ui/CheckOutModal';
import {
	nav,
	hero,
	promises,
	whatIs,
	aware,
	gallery,
	painStats,
	team,
	connect,
	videoShowcase,
	story,
	curriculum,
	pricing,
	testimonials,
	faq,
	cta,
	footer,
} from './hermesLandingContent';
import { defaultLocale } from '../../../i18n';

const title = 'Hermes Agent — Đội ngũ AI tự chủ cho Solo CEO';
const description =
	'Từ AI-aware đến AI-operator. Hermes coach Solo CEO xây đội AI tự chạy việc lặp lại: báo giá, email, content, briefing — không cần biết code.';

// Shared container for every section — single source of truth.
// `page`  = centred, capped width + responsive side gutters.
// `wrap`  = vertical rhythm between sections (24px mobile / 32px desktop).
const page = 'mx-auto w-full max-w-[1200px] px-[18px] sm:px-8';
const wrap = 'py-6 sm:py-8';
---

<!doctype html>
<html lang={defaultLocale}>
	<head>
		<BaseHead title={title} description={description} image={HermesOgImage} locale={defaultLocale} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Space+Mono:wght@400;700&family=Newsreader:ital,opsz,wght@0,6..72,400..600;1,6..72,400..500&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body class="hermes-landing hermes-grid-bg">
		<!-- NAV -->
		<nav class="sticky top-0 z-50 border-b-2 border-hermes-ink bg-hermes-paper">
			<div class={`${page} flex h-[58px] items-center gap-3`}>
				<div
					class="flex h-full min-w-0 items-center gap-2 pr-3 font-hermes-mono text-[13px] font-bold uppercase tracking-[0.04em] sm:gap-2.5 sm:border-r-2 sm:border-hermes-ink sm:pr-[26px]"
				>
					<Image
						src={DavidTungLogo}
						alt="David Tung"
						class="!h-5 w-auto !rounded-none sm:!h-6"
					/>
					<span class="text-hermes-hair">|</span>
					<Image
						src={HermesIcon}
						alt="Hermes"
						class="!h-[18px] w-auto !rounded-none sm:!h-[22px]"
					/>
					<span class="hidden whitespace-nowrap min-[420px]:inline"
						>{nav.brandName} <b class="text-hermes-orange">{nav.brandAccent}</b></span
					>
				</div>
				<div
					class="hidden flex-1 gap-[26px] pl-[26px] font-hermes-mono text-xs tracking-[0.04em] lg:flex"
				>
					{
						nav.links.map((link) => (
							<a href={link.href} class="!text-hermes-muted hover:!text-hermes-orange">
								{link.label}
							</a>
						))
					}
				</div>
				<a
					href={nav.cta.href}
					class="ml-auto shrink-0 whitespace-nowrap bg-hermes-ink px-4 py-2.5 font-hermes-mono text-xs font-bold !text-hermes-paper lg:ml-0"
				>
					{nav.cta.label}
				</a>
			</div>
		</nav>

		<!-- HERO -->
		<header class="relative overflow-hidden">
			<HeroAnimatedBackground />
			<div class={`${page} relative z-10`}>
				<div class="grid grid-cols-1 border-2 border-dashed border-t-0 border-hermes-ink lg:grid-cols-[1.1fr_0.9fr]">
					<div
						class="flex flex-col gap-8 border-dashed border-hermes-ink px-6 py-12 sm:px-12 sm:py-16 lg:border-b-0"
					>
						<span class="hermes-eyebrow">{hero.eyebrow}</span>
						<h1 class="my-6 text-5xl sm:text-6xl lg:text-7xl">
							{hero.titleLead}{' '}
							<span class="font-hermes-serif font-medium italic tracking-[-0.01em]">
								{hero.titleAware}
							</span><br />
							{hero.titleMid}{' '}
							<em class="not-italic text-hermes-orange">{hero.titleOperator}</em><br />
							{hero.titleTail}
						</h1>
						<p class="text-hermes-muted">{hero.lede}</p>
						<div class="mt-9 flex border-2 border-hermes-ink">
							<a
								href={hero.primaryCta.href}
								class="hermes-press flex flex-1 items-center justify-center gap-2.5 border-r-2 border-hermes-orange bg-hermes-orange px-6 py-[15px] text-center font-hermes-sans text-sm font-bold !text-white"
							>
								{hero.primaryCta.label}
							</a>
							<a
								href={hero.secondaryCta.href}
								class="flex flex-1 items-center justify-center gap-2.5 bg-hermes-card px-6 py-[15px] text-center font-hermes-sans text-sm font-bold !text-hermes-ink hover:bg-hermes-ink hover:!text-hermes-paper"
							>
								{hero.secondaryCta.label}
							</a>
						</div>
					</div>
					<div id="demo" class="flex flex-col p-4 sm:p-8">
						<div
							class="flex h-[420px] flex-col border-2 border-dashed border-hermes-ink bg-hermes-ink sm:h-[460px]"
						>
							<div
								class="flex items-center gap-2.5 border-b-2 border-hermes-line-soft bg-hermes-ink px-3.5 py-3 font-hermes-mono text-xs text-hermes-paper"
							>
								<span
									class="grid h-[26px] w-[26px] place-items-center bg-hermes-orange font-hermes-sans font-bold text-white"
								>
									H
								</span>
								<span>{hero.chatBarLabel}</span>
								<span
									class="ml-auto inline-flex items-center gap-1.5 font-hermes-mono text-[10px] tracking-[0.1em] opacity-70"
								>
									<span class="hermes-live-dot h-[7px] w-[7px] rounded-full bg-hermes-orange"></span>
									{hero.chatLiveLabel}
								</span>
							</div>
							<LiveChat client:visible />
						</div>
					</div>
				</div>
			</div>
		</header>

		<!-- PROMISES -->
		<section>
			<div class={`${page} ${wrap} pb-0`}>
				<div class="grid grid-cols-1 md:grid-cols-3">
					{
						promises.map((p, i) => (
							<div
								class:list={[
									'border-2 border-hermes-ink px-7 py-8 md:border-r-0 last:md:border-r-2 flex-col flex gap-4',
									i > 0 && 'border-t-0 md:border-t-2',
								]}
							>
								<div class="font-hermes-mono text-xs font-bold text-hermes-orange">{p.n}</div>
								<h4 class="my-4 text-[22px]">{p.title}</h4>
								<p class="text-[15px] leading-[1.55] text-hermes-muted">{p.body}</p>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<!-- WHAT IS HERMES
		<section id="what-is">
			<div class={`${page} ${wrap}`}>
				<div class="border-2 border-hermes-ink bg-hermes-card px-8 py-8 sm:px-10">
					<div class="flex max-w-[78ch] flex-col gap-4">
						<span class="hermes-eyebrow">{whatIs.eyebrow}</span>
						<p class="text-[17px] leading-[1.65] text-hermes-muted">{whatIs.body}</p>
						<p class="text-[17px] leading-[1.7] text-hermes-muted">{whatIs.body2}</p>
					</div>
				</div>
			</div>
		</section> -->
		<!-- CONNECT / FLOW DIAGRAM -->
		<section id="connect">
			<div class={`${page} ${wrap}`}>
				<div class="mb-11 flex flex-wrap items-end justify-between gap-8">
					<div>
						<span class="hermes-eyebrow">{connect.eyebrow}</span>
						<h2 class="mt-4 max-w-[20ch] text-3xl sm:text-4xl lg:text-5xl">{connect.title}</h2>
					</div>
					<p class="max-w-[56ch] text-[16px] leading-[1.6] text-hermes-muted">{connect.lede}</p>
				</div>
				<FlowDiagram client:visible coreIcon={HermesIcon.src} />
			</div>
		</section>

		<!-- VIDEO SHOWCASE -->
		<section id="videos">
			<div class={`${page} ${wrap}`}>
				<div class="mb-8 flex flex-wrap items-end justify-between gap-8">
					<div>
						<span class="hermes-eyebrow">{videoShowcase.eyebrow}</span>
						<h2 class="mt-4 max-w-[20ch] text-3xl sm:text-4xl lg:text-5xl">
							{videoShowcase.title}
						</h2>
					</div>
					<p class="max-w-[56ch] text-[16px] leading-[1.6] text-hermes-muted">
						{videoShowcase.lede}
					</p>
				</div>
				<VideoShowcase client:visible />
			</div>
		</section>

		<!-- GALLERY
		<section id="gallery">
			<div class={`${page} ${wrap}`}>
				<div class="mb-11 flex flex-wrap items-end justify-between gap-8">
					<div>
						<span class="hermes-eyebrow">{gallery.eyebrow}</span>
						<h2 class="mt-4 max-w-[18ch] text-3xl sm:text-4xl lg:text-5xl">{gallery.title}</h2>
					</div>
					<p class="max-w-[56ch] text-[16px] leading-[1.6] text-hermes-muted">{gallery.lede}</p>
				</div>
				<div class="grid grid-cols-2 gap-0.5 border-2 border-hermes-ink bg-hermes-ink md:grid-cols-4">
					{
						gallery.slots.map((slot) => (
							<div
								class:list={[
									'flex items-center justify-center bg-hermes-card p-4 text-center font-hermes-mono text-[10px] uppercase tracking-[0.08em] text-hermes-muted',
									slot.wide
										? 'col-span-2 aspect-[16/9] md:aspect-[16/9]'
										: 'aspect-[4/3]',
								]}
							>
								{slot.placeholder}
							</div>
						))
					}
				</div>
			</div>
		</section> -->

		<!-- AWARE vs OPERATOR -->
		<section id="aware">
			<div class={`${page} ${wrap} flex flex-col gap-4`}>
				<span class="hermes-eyebrow">{aware.eyebrow}</span>
				<h2 class="my-5 max-w-[20ch] text-3xl sm:text-4xl lg:text-5xl">
					Hai trạng thái. Một khoảng cách tên là{' '}
					<span class="font-hermes-serif font-medium italic">{aware.titleEm}</span>
				</h2>
				<div class="grid grid-cols-1 border-2 border-hermes-ink md:grid-cols-2">
					<div class="border-b-2 flex flex-col gap-4 border-hermes-ink bg-hermes-card px-8 py-9 md:border-b-0 md:border-r-2">
						<h3 class="mb-6 font-hermes-mono text-[13px] uppercase tracking-[0.1em]">
							{aware.left.heading}
						</h3>
						<ul class="flex flex-col gap-3.5">
							{
								aware.left.items.map((item) => (
									<li class="relative pl-6 text-[15.5px] leading-[1.4] before:absolute before:left-0 before:opacity-60 before:content-['→']">
										{item}
									</li>
								))
							}
						</ul>
					</div>
					<div class="flex flex-col gap-4 bg-hermes-orange px-8 py-9 text-white">
						<h3 class="mb-6 font-hermes-mono text-[13px] uppercase tracking-[0.1em]">
							{aware.right.heading}
						</h3>
						<ul class="flex flex-col gap-3.5">
							{
								aware.right.items.map((item) => (
									<li class="relative pl-6 text-[15.5px] leading-[1.4] before:absolute before:left-0 before:opacity-60 before:content-['→']">
										{item}
									</li>
								))
							}
						</ul>
					</div>
				</div>
			</div>
		</section>


		<!-- PAIN DASHBOARD -->
		<section id="results" class="bg-hermes-ink text-hermes-paper">
			<div class={`${page} ${wrap}  flex flex-col gap-4`}>
				<span class="hermes-eyebrow">{painStats.eyebrow}</span>
				<h2 class="my-5 max-w-[24ch] text-3xl leading-tight sm:text-4xl">{painStats.title}</h2>
				<div class="grid grid-cols-1 border-2 border-hermes-line-soft md:grid-cols-3">
					{
						painStats.stats.map((stat, i) => (
							<div
								class:list={[
									'px-7 py-10 md:border-r-2 md:border-hermes-line-soft last:md:border-r-0',
									i > 0 && 'border-t-2 border-hermes-line-soft md:border-t-0',
								]}
							>
								<div class="mb-5 font-hermes-mono text-[11px] uppercase tracking-[0.12em] opacity-50">
									{stat.k}
								</div>
								<div class="text-6xl font-bold leading-[0.95] tracking-[-0.03em] text-hermes-orange sm:text-7xl lg:text-8xl">
									{stat.big}
								</div>
								<div class="mt-3.5 max-w-[26ch] text-[15px] opacity-80">{stat.lab}</div>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<!-- TEAM -->
		<section id="team">
			<div class={`${page} ${wrap}`}>
				<div class="mb-11 flex flex-wrap items-end justify-between gap-8">
					<div>
						<span class="hermes-eyebrow">{team.eyebrow}</span>
						<h2 class="mt-4 max-w-[18ch] text-3xl sm:text-4xl lg:text-5xl">{team.title}</h2>
					</div>
					<p class="max-w-[56ch] text-[16px] leading-[1.6] text-hermes-muted">{team.lede}</p>
				</div>
				<div class="grid grid-cols-1 gap-0.5 border-2 border-hermes-ink bg-hermes-ink sm:grid-cols-2 lg:grid-cols-3">
					{
						team.agents.map((agent) => (
							<div
								class:list={[
									'flex min-h-[200px] flex-col px-6 py-7',
									agent.core ? 'bg-hermes-orange text-white' : 'bg-hermes-card',
								]}
							>
								<div class="flex items-baseline justify-between">
									<span
										class:list={[
											'font-hermes-mono text-[11px]',
											agent.core ? 'text-white/90' : 'text-hermes-muted',
										]}
									>
										{agent.num}
									</span>
									<span
										class:list={[
											'font-hermes-mono text-[10px] font-bold uppercase tracking-[0.08em]',
											agent.core ? 'text-white/90' : 'text-hermes-orange',
										]}
									>
										{agent.dept}
									</span>
								</div>
								<h4 class="mb-1 mt-4 text-[25px]">{agent.name}</h4>
								<span
									class:list={[
										'font-hermes-mono text-xs',
										agent.core ? 'text-white/90' : 'text-hermes-muted',
									]}
								>
									{agent.role}
								</span>
								<p
									class:list={[
										'mt-auto pt-4 text-[14.5px] leading-[1.5]',
										agent.core ? 'text-white/90' : 'text-hermes-muted',
									]}
								>
									{agent.body}
								</p>
							</div>
						))
					}
				</div>
			</div>
		</section>



		<!-- MOCKUPS -->
		<section class="bg-hermes-paper-alt">
			<div class={`${page} ${wrap}`}>
				<div class="mb-7 flex flex-wrap items-end justify-between gap-8">
					<div>
						<span class="hermes-eyebrow">Output thật</span>
						<h2 class="mt-4 text-3xl sm:text-4xl lg:text-5xl">5 agent làm ra gì mỗi ngày?</h2>
					</div>
					<p class="max-w-[56ch] text-[16px] leading-[1.6] text-hermes-muted">
						Không phải lời hứa trừu tượng. Đây là những gì rơi vào hộp thư và bảng tính của anh.
					</p>
				</div>
				<div
					id="sceneBadge"
					class="mb-[18px] inline-flex items-center gap-2 font-hermes-mono text-[11px] uppercase tracking-[0.08em] text-hermes-orange opacity-0 transition-opacity duration-300"
				>
					<span class="hermes-live-dot h-[7px] w-[7px] rounded-full bg-hermes-orange"></span>
					<span data-scene-text>HERMES ĐANG LÀM VIỆC…</span>
				</div>
				<div id="mocks" class="grid grid-cols-1 gap-[18px] md:grid-cols-2">
					<!-- Briefing -->
					<div class="hermes-mock border-2 border-hermes-ink bg-hermes-card">
						<div
							class="flex items-center gap-2 bg-hermes-ink px-3 py-2.5 font-hermes-mono text-[11px] text-hermes-paper"
						>
							<span class="h-2.5 w-2.5 rounded-full bg-[#3a352c]"></span>
							<span class="h-2.5 w-2.5 rounded-full bg-[#3a352c]"></span>
							<span class="ml-1.5 opacity-80">Hermès Daily · Email — Briefing 7:00</span>
						</div>
						<div class="p-4">
							<div class="font-hermes-mono text-[11px] font-bold text-hermes-orange">
								▸ Briefing sáng · Thứ Ba, 24/06
							</div>
							<ul class="mt-2.5 flex flex-col gap-2">
								{
									[
										'3 lead nóng cần phản hồi trước trưa (Sơn, Hà, Minh).',
										'2 báo giá quá hạn follow-up — Funnel đã nhắc.',
										'Post Facebook 19h đã lên lịch, chờ anh duyệt.',
										'Doanh thu tuần: 142tr (+18% so tuần trước).',
									].map((line) => (
										<li class="relative pl-[18px] text-[13px] before:absolute before:left-0 before:text-hermes-orange before:content-['▸']">
											{line}
										</li>
									))
								}
							</ul>
						</div>
					</div>
					<!-- Pipeline sheet -->
					<div class="hermes-mock border-2 border-hermes-ink bg-hermes-card">
						<div
							class="flex items-center gap-2 bg-hermes-ink px-3 py-2.5 font-hermes-mono text-[11px] text-hermes-paper"
						>
							<span class="h-2.5 w-2.5 rounded-full bg-[#3a352c]"></span>
							<span class="h-2.5 w-2.5 rounded-full bg-[#3a352c]"></span>
							<span class="ml-1.5 opacity-80">Hermès Funnel · Google Sheets — Pipeline</span>
						</div>
						<div class="font-hermes-mono text-[11px]">
							{
								[
									{ a: 'Khách', b: 'Trạng thái', c: 'Giá trị', head: true },
									{ a: 'Anh Minh · ACME', b: 'Đã báo giá', c: '32.4tr' },
									{ a: 'Chị Hà · Bloom', b: 'Follow-up 3d', c: '12.0tr' },
									{ a: 'Anh Sơn · Vela', b: 'Nóng', c: '48.5tr' },
									{ a: 'Chị Lan · Koi', b: 'Mới', c: '—', last: true },
								].map((row) => (
									<div
										class:list={[
											'grid grid-cols-[1.4fr_1fr_0.8fr]',
											!row.last && 'border-b border-hermes-hair',
											row.head && 'bg-[#f0ece3] font-bold text-hermes-muted',
										]}
									>
										<div class="border-r border-hermes-hair px-2 py-2">{row.a}</div>
										<div
											class:list={[
												'border-r border-hermes-hair px-2 py-2',
												!row.head && 'text-hermes-orange',
											]}
										>
											{row.b}
										</div>
										<div class="px-2 py-2">{row.c}</div>
									</div>
								))
							}
						</div>
					</div>
					<!-- Gmail -->
					<div class="hermes-mock border-2 border-hermes-ink bg-hermes-card">
						<div
							class="flex items-center gap-2 bg-hermes-ink px-3 py-2.5 font-hermes-mono text-[11px] text-hermes-paper"
						>
							<span class="h-2.5 w-2.5 rounded-full bg-[#3a352c]"></span>
							<span class="h-2.5 w-2.5 rounded-full bg-[#3a352c]"></span>
							<span class="ml-1.5 opacity-80">Hermès Sales · Gmail — Thư đi</span>
						</div>
						<div class="p-4 font-hermes-sans">
							<div class="text-[13px] font-bold">Tới: minh@acme.vn</div>
							<div class="my-1 text-[13px]">Báo giá gói Pro — Hợp đồng 12 tháng (#BG-204)</div>
							<div class="text-[12.5px] leading-[1.5] text-hermes-muted">
								Kính gửi anh Minh, cảm ơn anh đã quan tâm. Em xin gửi báo giá gói Pro cho 12 tháng,
								tổng 32.400.000₫ đã gồm VAT. File chi tiết đính kèm…
							</div>
							<span class="mt-3 inline-block bg-hermes-orange px-3.5 py-1.5 font-hermes-mono text-[11px] text-white">
								GỬI ✓
							</span>
						</div>
					</div>
					<!-- Facebook -->
					<div class="hermes-mock border-2 border-hermes-ink bg-hermes-card">
						<div
							class="flex items-center gap-2 bg-hermes-ink px-3 py-2.5 font-hermes-mono text-[11px] text-hermes-paper"
						>
							<span class="h-2.5 w-2.5 rounded-full bg-[#3a352c]"></span>
							<span class="h-2.5 w-2.5 rounded-full bg-[#3a352c]"></span>
							<span class="ml-1.5 opacity-80">Hermès Voice + Visual · Facebook — Lên lịch</span>
						</div>
						<div class="p-4">
							<div class="mb-2.5 flex items-center gap-2">
