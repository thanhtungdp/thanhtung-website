---
import { Image } from 'astro:assets';
import BaseHead from '../BaseHead.astro';
import Footer from '../Footer.astro';
import Header from '../Header.astro';
import { SITE_TITLE } from '../../consts';
import { localizePath, type Locale } from '../../i18n';
import '../../../tokens.css';
import EventFeature from '../../assets/projects/sale-ai/event-demo-feature.webp';
import QuoteFeature from '../../assets/projects/sale-ai/quote-60s-feature.webp';
import PainSlide from '../../assets/projects/sale-ai/slide-08.webp';
import FlowSlide from '../../assets/projects/sale-ai/slide-14.webp';
import KpiSlide from '../../assets/projects/sale-ai/slide-20.webp';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const isVi = locale === 'vi';

const copy = isVi
	? {
			title: 'ADG Sale AI — Case study AI Agent cho 2.000 đại lý',
			description:
				'Case study ADG Sale AI: lớp AI Agent kết nối đại lý và sales với SAP/CRM, rút quy trình tư vấn, báo giá và tạo đơn hàng xuống dưới 120 giây.',
			back: 'Về trang chủ',
			meta: ['Case study', 'AI Agent / Product Architecture', 'Enterprise distribution'],
			heroTitle: 'Từ ảnh công trình đến đơn hàng trong 120 giây.',
			heroLead:
				'ADG Sale AI đặt một lớp giao tiếp tự nhiên lên SAP/CRM để 2.000 đại lý tra cứu sản phẩm, dựng cấu hình, tạo báo giá và lên đơn ngay tại điểm bán.',
			primaryCta: 'Theo dõi flow 120 giây',
			secondaryCta: 'Xem bằng chứng triển khai',
			heroCaption: 'Giới thiệu Sale AI tại hội nghị khách hàng và đại lý của Austdoor Group.',
			snapshotTitle: 'Bài toán không nằm ở ERP. Nó nằm ở 15 phút trước khi khách rời cửa hàng.',
			snapshotBody:
				'Sản phẩm nhiều cấu hình, bảng giá khó nhớ và dữ liệu nằm rải rác khiến đại lý phải chờ sales hỗ trợ. Mỗi phút chờ làm giảm chất lượng tư vấn tại điểm bán — nơi quyết định chuyển đổi thực sự diễn ra.',
			baseline: [
				{ value: '2.000', label: 'đại lý C1/C2 cần cùng một chuẩn tư vấn' },
				{ value: '5–15 phút', label: 'thời gian phản hồi cũ tại điểm bán' },
				{ value: '< 60 giây', label: 'mục tiêu cho mỗi bước báo giá và tạo đơn' },
			],
			workflowTitle: 'Một flow bán hàng. Năm điểm kiểm soát.',
			workflowLead:
				'Agent không thay thế hệ thống lõi. Nó gom đúng dữ liệu, đúng quyền và đúng thời điểm thành một luồng mà đại lý có thể hoàn thành ngay trước mặt khách hàng.',
			stages: [
				{
					n: '01',
					title: 'Nhận bối cảnh',
					time: '0–15 giây',
					text: 'Đại lý tải ảnh công trình, nhập kích thước, ngân sách và nhu cầu sử dụng thay vì mô tả qua nhiều cuộc gọi.',
					input: 'Ảnh + kích thước + ngân sách',
					output: 'Brief bán hàng có cấu trúc',
				},
				{
					n: '02',
					title: 'Đề xuất cấu hình',
					time: '15–40 giây',
					text: 'Sale AI đối chiếu catalogue, tài liệu kỹ thuật, điều kiện thi công và chính sách để thu hẹp phương án phù hợp.',
					input: 'Knowledge base + policy',
					output: 'Phương án có lý do',
				},
				{
					n: '03',
					title: 'Tạo báo giá',
					time: '40–60 giây',
					text: 'Bảng giá và quyền đại lý được áp dụng tự động; sales chỉ cần rà soát ngoại lệ thay vì dựng báo giá từ đầu.',
					input: 'Cấu hình + bảng giá theo quyền',
					output: 'Báo giá sẵn gửi khách',
				},
				{
					n: '04',
					title: 'Lên đơn',
					time: '60–120 giây',
					text: 'Dữ liệu đã xác nhận chuyển thành đơn hàng và đồng bộ về SAP/CRM, giữ nguyên vai trò kiểm soát của hệ thống lõi.',
					input: 'Báo giá đã duyệt',
					output: 'Đơn hàng đồng bộ',
				},
				{
					n: '05',
					title: 'Đo adoption',
					time: 'Hàng tuần',
					text: 'Dashboard theo dõi tốc độ phản hồi, mức sử dụng, conversion và các bước thường cần con người can thiệp.',
					input: 'Event vận hành',
					output: 'KPI để cải tiến agent',
				},
			],
			architectureTitle: 'AI ở giữa. Quyền quyết định vẫn ở hai đầu.',
			architectureLead:
				'Sale AI chỉ đọc và hành động trong phạm vi được cấp. Đại lý giữ ngữ cảnh khách hàng; SAP/CRM giữ dữ liệu chuẩn; con người duyệt các ngoại lệ có tác động lớn.',
			architecture: [
				{ title: 'Đại lý & Sales', text: 'Cung cấp bối cảnh, chọn phương án và duyệt trước khi gửi khách.' },
				{ title: 'Sale AI', text: 'Hiểu yêu cầu, truy xuất tri thức, áp chính sách và điều phối workflow.' },
				{ title: 'SAP / CRM', text: 'Giữ master data, bảng giá, đơn hàng, phân quyền và lịch sử giao dịch.' },
			],
			proofTitle: 'Bằng chứng trước lời hứa.',
			proofLead:
				'Case study phân biệt rõ mục tiêu thiết kế, giả định tài chính và cơ chế đo sau triển khai — không biến mọi con số trong deck thành kết quả đã xác nhận.',
			proofItems: [
				{ title: 'Mục tiêu vận hành', value: '70–80%', text: 'Mức giảm thời gian tư vấn và báo giá được đặt làm mục tiêu để đo sau triển khai.' },
				{ title: 'Kịch bản tài chính', value: '3–5×', text: 'ROI năm đầu là mô hình ước tính dựa trên quy mô đại lý và giả định conversion.' },
				{ title: 'Governance', value: 'Human + AI', text: 'Ngoại lệ, bảo mật và quyết định cuối cùng luôn có người chịu trách nhiệm.' },
			],
			galleryTitle: 'Từ sân khấu đến mô hình vận hành.',
			gallery: [
				{ title: 'Nỗi đau ngành cửa', note: 'Bối cảnh trước khi thiết kế giải pháp', image: PainSlide },
				{ title: 'Flow chốt đơn 120 giây', note: 'Chuỗi thao tác tại điểm bán', image: FlowSlide },
				{ title: 'KPI của dự án', note: 'Những chỉ số cần theo dõi sau triển khai', image: KpiSlide },
			],
			closingTitle: 'AI Agent chỉ có giá trị khi đi hết đường tới giao dịch.',
			closingBody:
				'Tôi thiết kế Sale AI như một lớp vận hành có thể đo được — kết nối knowledge, quyền dữ liệu, hành động nghiệp vụ và nhịp cải tiến hàng tuần.',
			contact: 'Trao đổi về AI Agent cho sales',
		}
	: {
			title: 'ADG Sale AI — AI Agent case study for 2,000 dealers',
			description:
				'ADG Sale AI case study: an AI Agent layer connecting dealers and sales teams to SAP/CRM, compressing consultation, quoting, and ordering into under 120 seconds.',
			back: 'Back home',
			meta: ['Case study', 'AI Agent / Product Architecture', 'Enterprise distribution'],
			heroTitle: 'From site photo to order in 120 seconds.',
			heroLead:
				'ADG Sale AI adds a natural interface over SAP/CRM so 2,000 dealers can find products, configure an option, quote, and order while the customer is still at the counter.',
			primaryCta: 'Follow the 120-second flow',
			secondaryCta: 'See implementation evidence',
			heroCaption: 'Sale AI presented at Austdoor Group’s customer and dealer conference.',
			snapshotTitle: 'The bottleneck was not the ERP. It was the 15 minutes before a customer left the store.',
			snapshotBody:
				'Complex configurations, hard-to-recall pricing, and fragmented documents forced dealers to wait for sales support. Every minute weakened consultation at the exact point where conversion was decided.',
			baseline: [
				{ value: '2,000', label: 'C1/C2 dealers needing one consultation standard' },
				{ value: '5–15 min', label: 'previous point-of-sale response time' },
				{ value: '< 60 sec', label: 'target for each quote and order step' },
			],
			workflowTitle: 'One sales flow. Five control points.',
			workflowLead:
				'The agent does not replace core systems. It assembles the right data, permission, and timing into a flow a dealer can complete in front of the customer.',
			stages: [
				{ n: '01', title: 'Capture context', time: '0–15 sec', text: 'The dealer uploads a site photo and enters dimensions, budget, and intent instead of explaining the job across multiple calls.', input: 'Photo + dimensions + budget', output: 'Structured sales brief' },
				{ n: '02', title: 'Recommend a configuration', time: '15–40 sec', text: 'Sale AI checks catalogues, technical documents, installation constraints, and policy to narrow the right options.', input: 'Knowledge base + policy', output: 'Reasoned recommendation' },
				{ n: '03', title: 'Generate the quote', time: '40–60 sec', text: 'Dealer-specific pricing and permissions are applied automatically; sales reviews exceptions rather than rebuilding the quote.', input: 'Configuration + allowed pricing', output: 'Customer-ready quote' },
				{ n: '04', title: 'Create the order', time: '60–120 sec', text: 'Confirmed data becomes an order and syncs to SAP/CRM, preserving the core system as the operational source of truth.', input: 'Approved quote', output: 'Synchronized order' },
				{ n: '05', title: 'Measure adoption', time: 'Weekly', text: 'The dashboard tracks response time, usage, conversion, and the steps that still require human intervention.', input: 'Operating events', output: 'Agent improvement KPI' },
			],
			architectureTitle: 'AI in the middle. Accountability at both ends.',
			architectureLead:
				'Sale AI only reads and acts within assigned permissions. Dealers retain customer context; SAP/CRM retains governed data; people approve high-impact exceptions.',
			architecture: [
				{ title: 'Dealer & Sales', text: 'Provide context, choose the option, and approve before anything reaches the customer.' },
				{ title: 'Sale AI', text: 'Understands intent, retrieves knowledge, applies policy, and orchestrates the workflow.' },
				{ title: 'SAP / CRM', text: 'Owns master data, pricing, orders, permissions, and transaction history.' },
			],
			proofTitle: 'Evidence before promises.',
			proofLead:
				'The case study separates design targets, financial assumptions, and post-launch measurement instead of presenting every number in the deck as a verified result.',
			proofItems: [
				{ title: 'Operating target', value: '70–80%', text: 'Target reduction in consultation and quoting time, to be measured after rollout.' },
				{ title: 'Financial scenario', value: '3–5×', text: 'First-year ROI is an estimate based on dealer scale and conversion assumptions.' },
				{ title: 'Governance', value: 'Human + AI', text: 'Exceptions, security, and final decisions remain assigned to accountable people.' },
			],
			galleryTitle: 'From the stage to the operating model.',
			gallery: [
				{ title: 'Door-industry pain points', note: 'The context before solution design', image: PainSlide },
				{ title: 'The 120-second closing flow', note: 'Point-of-sale operating sequence', image: FlowSlide },
				{ title: 'Project KPI', note: 'What must be measured after rollout', image: KpiSlide },
			],
			closingTitle: 'An AI Agent matters only when it reaches the transaction.',
			closingBody:
				'I designed Sale AI as a measurable operating layer — connecting knowledge, permissions, business actions, and a weekly improvement rhythm.',
			contact: 'Discuss AI Agents for sales',
		};
---

<BaseHead title={`${copy.title} | ${SITE_TITLE}`} description={copy.description} image={EventFeature} locale={locale} />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
<link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />

<div class="sale-ai-case">
	<Header locale={locale} />
	<main>
		<section class="case-hero case-shell">
			<div class="hero-copy case-reveal" style="--reveal-index: 0">
				<a class="back-link" href={localizePath('/', locale)}>← {copy.back}</a>
				<ul class="meta-list" aria-label="Project metadata">
					{copy.meta.map((item) => <li>{item}</li>)}
				</ul>
				<h1>{copy.heroTitle}</h1>
				<p class="hero-lead">{copy.heroLead}</p>
				<div class="hero-actions">
					<a class="case-button case-button-primary" href="#workflow">{copy.primaryCta}</a>
					<a class="case-button case-button-secondary" href="#proof">{copy.secondaryCta}</a>
				</div>
			</div>
			<figure class="hero-figure case-reveal" style="--reveal-index: 1">
				<Image src={EventFeature} alt={copy.heroCaption} widths={[640, 900, 1150]} sizes="(max-width: 959px) 100vw, 48vw" loading="eager" />
				<figcaption>{copy.heroCaption}</figcaption>
			</figure>
		</section>

		<section class="snapshot case-shell" aria-labelledby="snapshot-title">
			<div class="snapshot-copy">
				<h2 id="snapshot-title">{copy.snapshotTitle}</h2>
				<p>{copy.snapshotBody}</p>
			</div>
			<div class="baseline" aria-label="Project baseline and targets">
				{copy.baseline.map((item) => (
					<div class="baseline-item">
						<strong>{item.value}</strong>
						<span>{item.label}</span>
					</div>
				))}
			</div>
		</section>

		<section class="workflow case-shell" id="workflow" aria-labelledby="workflow-title">
			<header class="section-intro">
				<h2 id="workflow-title">{copy.workflowTitle}</h2>
				<p>{copy.workflowLead}</p>
			</header>

			<div class="workflow-layout">
				<nav class="stage-index" aria-label="Workflow stages">
					{copy.stages.map((stage, index) => (
						<a href={`#stage-${stage.n}`} data-stage-link={index}>
							<span>{stage.n}</span>
							<strong>{stage.title}</strong>
							<small>{stage.time}</small>
						</a>
					))}
				</nav>

				<div class="stage-story">
					{copy.stages.map((stage, index) => (
						<article class="stage" id={`stage-${stage.n}`} data-stage={index}>
							<div class="stage-heading">
								<span>{stage.n}</span>
								<div>
									<p>{stage.time}</p>
									<h3>{stage.title}</h3>
								</div>
							</div>
							<p class="stage-copy">{stage.text}</p>
							<div class="stage-io">
								<div><span>Input</span><strong>{stage.input}</strong></div>
								<svg viewBox="0 0 120 24" aria-hidden="true">
									<path d="M2 12h108" />
									<path d="m101 4 10 8-10 8" />
								</svg>
								<div><span>Output</span><strong>{stage.output}</strong></div>
							</div>
							{index === 2 && (
								<figure class="stage-proof-image">
									<Image src={QuoteFeature} alt={isVi ? 'Minh họa tính năng tạo báo giá trong 60 giây' : 'Illustration of the 60-second quote feature'} widths={[640, 960, 1280]} sizes="(max-width: 959px) 100vw, 60vw" loading="lazy" />
								</figure>
							)}
						</article>
					))}
				</div>
			</div>
		</section>

		<section class="architecture-band" aria-labelledby="architecture-title">
			<div class="case-shell architecture-inner">
				<header class="section-intro inverse">
					<h2 id="architecture-title">{copy.architectureTitle}</h2>
					<p>{copy.architectureLead}</p>
				</header>
				<div class="architecture-diagram">
					{copy.architecture.map((item, index) => (
						<>
							<article class:list={{ 'architecture-node': true, agent: index === 1 }}>
								<span>{String(index + 1).padStart(2, '0')}</span>
								<h3>{item.title}</h3>
								<p>{item.text}</p>
							</article>
							{index < copy.architecture.length - 1 && (
								<svg class="architecture-connector" viewBox="0 0 96 24" aria-hidden="true">
									<path d="M2 12h84" />
									<path d="m78 4 10 8-10 8" />
								</svg>
							)}
						</>
					))}
				</div>
			</div>
		</section>

		<section class="proof case-shell" id="proof" aria-labelledby="proof-title">
			<header class="section-intro">
				<h2 id="proof-title">{copy.proofTitle}</h2>
				<p>{copy.proofLead}</p>
			</header>
			<div class="proof-list">
				{copy.proofItems.map((item) => (
					<article>
						<p>{item.title}</p>
						<strong>{item.value}</strong>
						<span>{item.text}</span>
					</article>
				))}
			</div>
		</section>

		<section class="gallery case-shell" aria-labelledby="gallery-title">
			<h2 id="gallery-title">{copy.galleryTitle}</h2>
			<p class="gallery-hint">{isVi ? 'Vuốt ngang để xem các slide tiếp theo →' : 'Swipe sideways to view the next slides →'}</p>
			<div class="gallery-strip">
				{copy.gallery.map((item, index) => (
					<figure>
						<Image src={item.image} alt={item.title} widths={[640, 900, 1100]} sizes="(max-width: 767px) 88vw, 56vw" loading="lazy" />
						<figcaption><span>{String(index + 1).padStart(2, '0')}</span><strong>{item.title}</strong><small>{item.note}</small></figcaption>
					</figure>
				))}
			</div>
		</section>

		<section class="case-close case-shell">
			<div>
				<h2>{copy.closingTitle}</h2>
				<p>{copy.closingBody}</p>
			</div>
			<a class="case-button case-button-primary" href="mailto:thanhtung@simplamo.com">{copy.contact}</a>
		</section>
	</main>
	<Footer />

	<script>
		const stages = Array.from(document.querySelectorAll<HTMLElement>('[data-stage]'));
		const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-stage-link]'));

		const activateStage = (index: number) => {
			links.forEach((link, linkIndex) => link.classList.toggle('active', linkIndex === index));
		};
		activateStage(0);

		if (stages.length && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
			const observer = new IntersectionObserver(
				(entries) => {
					const visible = entries
						.filter((entry) => entry.isIntersecting)
						.sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
					if (visible) activateStage(Number((visible.target as HTMLElement).dataset.stage ?? 0));
				},
				{ rootMargin: '-28% 0px -52% 0px', threshold: [0.1, 0.4, 0.7] },
			);
			stages.forEach((stage) => observer.observe(stage));
		}
	</script>
</div>

<style>
	/* Hallmark · pre-emit critique: P5 H5 E4 S5 R5 V5
	 * genre: modern-minimal · macrostructure: Narrative Workflow · theme: Cobalt
	 * enrichment: real project photography + tier-B SVG data-flow · motion: hero settle + active-stage tracking
	 */
	:global(html) {
		overflow-x: clip;
		scroll-behavior: smooth;
	}

	.sale-ai-case {
		--case-paper: var(--sale-ai-color-paper);
		--case-paper-2: var(--sale-ai-color-paper-2);
		--case-ink: var(--sale-ai-color-ink);
		--case-ink-2: var(--sale-ai-color-ink-2);
		--case-rule: var(--sale-ai-color-rule);
		--case-accent: var(--sale-ai-color-accent);
		--case-accent-soft: var(--sale-ai-color-accent-soft);
		--case-signal: var(--sale-ai-color-signal);
		--case-focus: var(--sale-ai-color-focus);
		--font-display: var(--sale-ai-font-display);
		--font-body: var(--sale-ai-font-body);
		--font-mono: var(--sale-ai-font-mono);
		--space-xs: var(--sale-ai-space-xs);
		--space-sm: var(--sale-ai-space-sm);
		--space-md: var(--sale-ai-space-md);
		--space-lg: var(--sale-ai-space-lg);
		--space-xl: var(--sale-ai-space-xl);
		--space-2xl: var(--sale-ai-space-2xl);
		--space-3xl: var(--sale-ai-space-3xl);
		--space-4xl: var(--sale-ai-space-4xl);
		--ease-out: var(--sale-ai-ease-out);
		--ease-in: var(--sale-ai-ease-in);
		--dur-micro: var(--sale-ai-dur-micro);
		--dur-short: var(--sale-ai-dur-short);
		--dur-long: var(--sale-ai-dur-long);
		margin: 0;
		overflow-x: clip;
		background: var(--case-paper);
		color: var(--case-ink);
		font-family: var(--font-body);
	}

	.sale-ai-case main {
		min-height: 100dvh;
	}

	.case-shell {
		width: min(1180px, calc(100% - 2rem));
		margin-inline: auto;
	}

	.case-hero {
		display: grid;
		grid-template-columns: minmax(0, 0.88fr) minmax(0, 1.12fr);
		gap: var(--space-2xl);
		align-items: end;
		min-height: clamp(32rem, 70dvh, 44rem);
		padding-block: var(--space-lg) var(--space-2xl);
	}

	.hero-copy {
		display: grid;
		gap: var(--space-lg);
		align-self: center;
		min-width: 0;
	}

	.back-link {
		width: fit-content;
		color: var(--case-ink-2);
		font-size: 0.86rem;
		font-weight: 600;
		text-decoration: none;
	}

	.back-link:hover {
		color: var(--case-accent);
	}

	.meta-list {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-sm) var(--space-lg);
		margin: 0;
