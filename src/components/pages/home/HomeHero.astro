---
import ButtonLink from '../../ui/ButtonLink.astro';
import ProofStatsStrip from '../../ui/ProofStatsStrip.astro';
import { SignalMarquee, TiltProfileCard } from '../../motion/HomeMotion';
import { localizePath, type Locale } from '../../../i18n';

type ProofStat = {
	value: string;
	label: string;
};

type ProfileCard = {
	name: string;
	title: string;
	location: string;
	email: string;
	focus: string;
	status: string;
};

interface Props {
	locale: Locale;
	isVi: boolean;
	focusSignals: string[];
	proofStats: ProofStat[];
	profileCard: ProfileCard;
}

const { locale, isVi, focusSignals, proofStats, profileCard } = Astro.props;
---

<section
	class="site-container flex flex-col gap-6 py-7 md:flex-row md:justify-between"
>
	<div class="relative z-10 flex w-full max-w-full flex-col gap-4 motion-hero-copy md:w-2/5">
		<h1
			class="max-w-full whitespace-nowrap text-nowrap leading-none tracking-normal sm:text-6xl lg:text-6xl"
			aria-label="Simple & More X10"
		>
			<span class="whitespace-nowrap text-nowrap">Simple &amp; More</span>{' '}
			<span
				class="inline-flex border-b-8 border-orange-200"
				aria-label="X10"
			>
				<span class="inline-block text-orange-700">X10</span>
			</span>
		</h1>

		<p class="max-w-2xl text-base leading-7 text-neutral-600 md:text-lg">
			{
				isVi
					? 'Giúp đội ngũ lãnh đạo biến dữ liệu, quy trình bán hàng và AI agents thành hệ thống vận hành tăng trưởng. Từng xây SaaS, IoT và AI products dùng thật ở quy mô lớn.'
					: 'I help leadership teams turn data, sales workflows, and AI agents into operating systems for growth. Built from real SaaS, IoT, and AI products at scale.'
			}
		</p>

		<div class="flex w-full flex-wrap gap-3 max-sm:flex-col">
			<ButtonLink href="mailto:thanhtung@simplamo.com">{isVi ? 'Trao đổi về AI & vận hành' : 'Discuss AI & operations'}</ButtonLink>
			<ButtonLink href={localizePath('/blog', locale)} variant="secondary">{isVi ? 'Đọc ghi chú thực thi' : 'Read execution notes'}</ButtonLink>
		</div>

		<div>
			<SignalMarquee items={focusSignals} client:load />
		</div>
	</div>

	<div class="relative z-10 grid w-full items-stretch gap-3 md:w-2/5" aria-label={isVi ? 'Tóm tắt năng lực' : 'Capability summary'}>
		<div class="min-w-0">
			<TiltProfileCard {...profileCard} client:load />
		</div>
		<ProofStatsStrip stats={proofStats} label={isVi ? '4 chỉ số chính' : '4 key metrics'} />
	</div>
</section>
