---
import ButtonLink from '../../ui/ButtonLink.astro';
import { SignalMarquee, TiltProfileCard } from '../../motion/HomeMotion';
import { localizePath, type Locale } from '../../../i18n';

type ProofStat = {
	value: string;
	label: string;
};

type ProfileCard = {
	name: string;
	title: string;
	location: string;
	email: string;
	focus: string;
	status: string;
};

interface Props {
	locale: Locale;
	isVi: boolean;
	focusSignals: string[];
	proofStats: ProofStat[];
	profileCard: ProfileCard;
}

const { locale, isVi, focusSignals, proofStats, profileCard } = Astro.props;
---

<section
	class="container mx-auto flex flex-col gap-6 px-4 py-7 md:flex-row md:justify-around md:px-6 lg:px-8"
>
	<div class="relative z-10 w-full max-w-full motion-hero-copy md:w-2/5">
		<h1
			class="max-w-full !whitespace-nowrap !text-nowrap !leading-none !tracking-normal sm:!text-6xl lg:!text-6xl"
			aria-label="Simple & More X10"
		>
			<span class="!whitespace-nowrap !text-nowrap">Simple &amp; More</span>{' '}
			<span
				class="inline-flex border-b-8 border-orange-200"
				aria-label="X10"
			>
				<span class="inline-block bg-gradient-to-r from-orange-600 via-teal-700 to-orange-600 bg-clip-text text-transparent">X10</span>
			</span>
		</h1>

		<p class="mt-4 max-w-2xl text-base leading-7 text-neutral-600 md:text-lg">
			{
				isVi
					? 'Giúp các doanh nghiệp phát triển các nền tảng tích hợp dựa trên nền tảng có sẵn ERP, Sales kết hợp cùng AI để tạo ra lợi thế cạnh tranh vượt bật Data x AI x Coaching = x10'
					: 'I build real AI products, ignite classrooms, and turn learners into makers with products used by real people.'
			}
		</p>

		<div class="mt-5 flex w-full flex-wrap gap-3 max-sm:flex-col">
			<ButtonLink href={localizePath('/blog', locale)}>{isVi ? 'Đọc bài viết' : 'Read writing'}</ButtonLink>
			<ButtonLink href="mailto:thanhtung@simplamo.com" variant="secondary">{isVi ? 'Liên hệ' : 'Contact'}</ButtonLink>
		</div>

		<div>
			<SignalMarquee items={focusSignals} client:load />
		</div>
	</div>

	<div class="relative z-10 grid w-full items-stretch gap-3 md:w-2/5" aria-label={isVi ? 'Tóm tắt năng lực' : 'Capability summary'}>
		<div class="min-w-0">
			<TiltProfileCard {...profileCard} client:load />
		</div>
		<div
			class="surface-card grid grid-cols-2 gap-2 overflow-hidden bg-white/90 p-2 sm:grid-cols-4"
			aria-label={isVi ? '4 chỉ số chính' : '4 key metrics'}
		>
			{
				proofStats.map((item) => (
					<div class="min-w-0 rounded-2xl bg-orange-50 p-3">
						<strong class="block text-xl leading-none tracking-tight text-neutral-950">{item.value}</strong>
						<span class="mt-2 block text-xs font-extrabold leading-tight text-neutral-500">{item.label}</span>
					</div>
				))
			}
		</div>
	</div>
</section>
